import { S, Theme, Icons, ChipData, ActionData, WjKey } from "theme.slint";

// White focus ring with a soft blue halo, drawn around its parent.
export component FocusRing inherits Rectangle {
    in property <length> radius: (16px * S.k);
    in property <bool> on;
    in property <length> w;
    in property <length> h;
    // The halo is a shadow, which fills the ring's shape: off over see-through cards.
    in property <bool> glow: true;
    x: -(4px * S.k);
    y: -(4px * S.k);
    width: w + (8px * S.k);
    height: h + (8px * S.k);
    border-radius: self.radius + (4px * S.k);
    border-width: (4px * S.k);
    border-color: Theme.ring;
    opacity: self.on ? 1 : 0;
    drop-shadow-blur: self.on && self.glow ? (28px * S.k) : 0;
    drop-shadow-color: Theme.glow;
    animate opacity { duration: Theme.fast; }
}

// Five stars filled to `score` (e.g. 3.74 → three full stars and most of the fourth).
export component Stars inherits HorizontalLayout {
    in property <float> score;
    in property <length> size: (17px * S.k);
    spacing: (2px * S.k);
    for i in [0, 1, 2, 3, 4]: Rectangle {
        width: root.size;
        height: root.size;
        Image { source: Icons.star; colorize: #ffffff33; width: root.size; height: root.size; }
        Rectangle {
            x: 0;
            width: root.size * clamp(root.score - i, 0, 1);
            height: root.size;
            clip: true;
            Image { x: 0; source: Icons.star; colorize: #ffc940; width: root.size; height: root.size; }
        }
    }
}

export component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> round;
    in property <color> fg: #ffffff;
    in property <color> bg: #ffffff24;
    height: (30px * S.k);
    width: round ? (30px * S.k) : max((30px * S.k), t.preferred-width + (16px * S.k));
    border-radius: round ? (15px * S.k) : (8px * S.k);
    background: bg;
    border-width: 1px;
    border-color: #ffffff1f;
    t := Text { text: root.text; font-size: (15px * S.k); font-weight: 700; color: root.fg; }
}

// A key of an on-screen keyboard (the Wi-Fi password, the Library's search), `w` keys wide.
// White is the highlight only; a switch that's on is filled blue and lit. A long label (a
// game's name) can take two lines.
export component KeyboardKey inherits Rectangle {
    in property <WjKey> k;
    in property <length> unit;
    in property <length> gap;
    in property <bool> two-lines;
    callback clicked();
    width: unit * k.w + gap * (k.w - 1);
    border-radius: (14px * S.k);
    background: k.focused ? (k.accent ? Theme.accent : #ffffff)
        : k.on ? #2f6fe0 : k.accent ? Theme.accent.with-alpha(0.35) : #ffffff12;
    border-width: 1px;
    border-color: k.on && !k.focused ? #8fb6ff66 : #ffffff14;
    drop-shadow-blur: k.focused ? (22px * S.k) : 0;
    drop-shadow-color: k.accent ? #0a6cffaa : #8cb9ff99;
    transform-scale: k.focused ? 1.06 : 1.0;
    animate background, transform-scale { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        spacing: (8px * S.k);
        if k.icon != "": Image {
            source: Icons.get(k.icon);
            colorize: k.focused && !k.accent ? (k.on ? Theme.accent : #0a0d18) : Theme.text;
            width: (20px * S.k);
            height: self.width;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: k.label;
            max-width: root.width - (28px * S.k);
            overflow: elide;
            wrap: root.two-lines ? word-wrap : no-wrap;
            horizontal-alignment: center;
            font-size: root.two-lines ? (16px * S.k) : k.w > 1 ? (18px * S.k) : (24px * S.k);
            font-weight: k.w > 1 ? 600 : 500;
            color: k.focused && !k.accent ? #0a0d18 : Theme.text;
            vertical-alignment: center;
        }
    }
    // The switch's light, like Caps Lock's.
    if k.on: Rectangle {
        x: parent.width - self.width - (9px * S.k);
        y: (9px * S.k);
        width: (8px * S.k);
        height: self.width;
        border-radius: self.width / 2;
        background: k.focused ? Theme.accent : #cfe0ff;
        drop-shadow-blur: (6px * S.k);
        drop-shadow-color: #8fb6ff;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Quiet navigation, not another primary action. Shortcut appears on hover; no layout jump.
export component BackButton inherits Rectangle {
    in property <bool> pad;
    callback clicked();
    width: (154px * S.k);
    height: (48px * S.k);
    border-radius: (12px * S.k);
    background: ta.has-hover ? #ffffff16 : transparent;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        padding-left: (6px * S.k);
        padding-right: (8px * S.k);
        spacing: (12px * S.k);
        alignment: center;
        Rectangle {
            width: (36px * S.k); height: (36px * S.k); y: (6px * S.k);
            border-radius: (18px * S.k); background: ta.has-hover ? #ffffff24 : #ffffff12;
            Image { source: Icons.chevl; colorize: Theme.text; width: (22px * S.k); height: (22px * S.k); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Text { text: @tr("Back"); font-size: (18px * S.k); font-weight: 500; color: Theme.text; vertical-alignment: center; }
        Text {
            text: root.pad ? "○" : "Esc"; font-size: (15px * S.k); color: root.pad ? #ff8f9c : Theme.text3;
            vertical-alignment: center; opacity: root.pad || ta.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <ChipData> data;
    height: (40px * S.k);
    border-radius: (20px * S.k);
    background: #ffffff17;
    border-width: 1px;
    border-color: #ffffff12;
    HorizontalLayout {
        padding-left: (16px * S.k);
        padding-right: (16px * S.k);
        spacing: (8px * S.k);
        if data.stars > 0: Stars {
            score: data.stars;
            y: (parent.height - self.preferred-height) / 2;
        }
        if data.dot > 0: Rectangle {
            width: (10px * S.k);
            height: (10px * S.k);
            y: (parent.height - self.height) / 2;
            border-radius: (5px * S.k);
            background: Theme.compat-color(data.dot);
        }
        if data.icon != "": Image {
            source: Icons.get(data.icon);
            colorize: data.gold ? #ffc940 : Theme.text2;
            width: (18px * S.k);
            height: (18px * S.k);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: data.text;
            color: Theme.text;
            font-size: (17px * S.k);
            vertical-alignment: center;
        }
    }
}

export component Btn inherits Rectangle {
    in property <ActionData> data;
    in property <bool> focused;
    // Another button in the same row is selected: the primary button steps back so only one
    // button ever looks selected.
    in property <bool> dim;
    in property <length> h: (68px * S.k);
    property <bool> solid: focused || (data.primary && !dim);
    callback clicked();
    // Icon-only buttons show their label when selected or hovered.
    property <bool> open: !data.round || focused || ta.has-hover;
    height: h;
    width: !open ? h : max(data.primary ? (240px * S.k) : (0px * S.k), row.preferred-width);
    clip: true;
    transform-scale: focused ? 1.05 : 1.0;
    animate width { duration: 300ms; easing: ease-out-expo; }
    animate transform-scale { duration: 220ms; easing: ease-out-back; }
    border-radius: h / 2;
    background: focused ? (data.danger ? Theme.danger : #ffffff)
        : data.primary && !dim ? #ffffffeb : data.danger ? #ff5a6a2e : data.primary ? #ffffff38 : #ffffff24;
    border-width: 1px;
    border-color: data.danger && !focused ? #ff5a6a5a : #ffffff1a;
    drop-shadow-blur: focused ? (28px * S.k) : 0;
    drop-shadow-color: focused ? #8cb9ffaa : transparent;
    animate background, drop-shadow-blur { duration: Theme.fast; }
    row := HorizontalLayout {
        alignment: center;
        padding-left: !open ? 0 : data.round ? (22px * S.k) : (36px * S.k);
        padding-right: !open ? 0 : data.round ? (26px * S.k) : (36px * S.k);
        spacing: (12px * S.k);
        // No icon: no gap where one would be.
        if data.icon != "": Image {
            source: Icons.get(data.icon);
            colorize: solid && !(focused && data.danger) ? #0a0d18 : #ffffff;
            width: (26px * S.k);
            height: (26px * S.k);
            y: (parent.height - self.height) / 2;
        }
        if open: Text {
            text: data.label;
            font-size: (22px * S.k);
            font-weight: 600;
            color: solid && !(focused && data.danger) ? #0a0d18 : #ffffff;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small caps line above a title: "● PLAYING 0:12", "NEW · ADDED SEP 22, 2026", "PLAYED 2 HR".
export component Kicker inherits HorizontalLayout {
    in property <string> text;
    in property <string> accent;
    in property <bool> live;
    spacing: (12px * S.k);
    alignment: start;
    height: (30px * S.k);
    if accent != "": Text {
        text: accent;
        font-size: (18px * S.k);
        font-weight: 600;
        letter-spacing: (2px * S.k);
        color: Theme.ok;
        vertical-alignment: center;
    }
    Text {
        text: root.text;
        font-size: (18px * S.k);
        font-weight: 600;
        letter-spacing: (2px * S.k);
        color: live ? Theme.text : Theme.text2;
        vertical-alignment: center;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <length> size: (13px * S.k);
    visible: text != "";
    width: label.preferred-width + (16px * S.k);
    height: label.preferred-height + (6px * S.k);
    border-radius: (6px * S.k);
    background: text == "Installed" ? Theme.ok : text == "Playing" ? Theme.ok : text == "New" ? Theme.accent : #000000b8;
    label := Text {
        text: root.text == "Playing" ? @tr("● PLAYING") : root.text == "Installed" ? @tr("INSTALLED") : root.text == "New" ? @tr("NEW") : root.text;
        font-size: size;
        font-weight: 700;
        letter-spacing: (1px * S.k);
        color: root.text == "Installed" || root.text == "Playing" ? #03140c : #ffffff;
    }
}

export component Switch inherits Rectangle {
    in property <bool> on;
    width: (58px * S.k);
    height: (32px * S.k);
    border-radius: (16px * S.k);
    background: on ? Theme.accent : #ffffff33;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: on ? (30px * S.k) : (4px * S.k);
        y: (4px * S.k);
        width: (24px * S.k);
        height: (24px * S.k);
        border-radius: (12px * S.k);
        background: #ffffff;
        animate x { duration: Theme.move; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

// Loading placeholder: a soft light sweeping across. Only animates while it is shown.
export component Shimmer inherits Rectangle {
    in property <bool> active;
    clip: true;
    visible: active;
    property <float> t: active ? animation-tick() / 1ms / 1000 : 0;
    Rectangle {
        x: (mod(t * 0.8, 1.6) - 0.3) * parent.width - self.width / 2;
        width: parent.width * 0.6;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff12 50%, #ffffff00 100%);
    }
}

// Cover art that never crops a logo: art with the frame's shape fills it; any other shape
// (square icons, landscape art) is shown whole, centred over a dimmed, stretched copy.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> loaded;
    property <float> aspect: source.height > 0 ? source.width / source.height : 0;
    property <float> frame: root.height > 0 ? root.width / root.height : 1;
    property <bool> fits: aspect > 0 && abs(aspect - frame) / frame < 0.08;
    if loaded && !fits: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        opacity: 0.45;
    }
    if loaded && !fits: Rectangle { background: #05070f8c; }
    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: root.fits ? cover : contain;
        opacity: root.loaded ? 1 : 0;
        animate opacity { duration: 250ms; }
    }
}

// Floating light: soft out-of-focus specks drifting up and swaying, twinkling, under a beam of
// light from the top left, as a console's welcome screens have. Warm specks with a few in the
// accent colour; a handful of large, very soft ones close by. Moves only while `running`.
export component Particles inherits Rectangle {
    in property <bool> running: true;
    in property <color> warm: #ffe0ad;
    in property <color> cool: Theme.accent.brighter(0.6);
    property <float> t: running ? animation-tick() / 1ms / 1000 : 0;
    clip: true;
    // The beam, breathing slowly: a wide glow and a brighter core.
    Rectangle {
        x: -parent.width * 0.25; y: -parent.height * 0.6;
        width: parent.width * 0.8; height: parent.height * 1.3;
        background: @radial-gradient(circle, #fff1dc40 0%, #fff1dc17 40%, #fff1dc00 70%);
        opacity: 0.8 + 0.2 * sin(root.t * 14deg);
    }
    Rectangle {
        x: parent.width * 0.04; y: -parent.height * 0.25;
        width: parent.width * 0.2; height: parent.height * 1.0;
        background: @radial-gradient(circle, #ffffff24 0%, #ffffff00 70%);
        opacity: 0.6 + 0.4 * sin(root.t * 9deg + 60deg);
    }
    for i in 64: Rectangle {
        // Golden-ratio steps spread the specks without any two lining up.
        property <float> sx: mod(i * 0.6180339 + 0.13, 1);
        property <float> sy: mod(i * 0.7548776 + 0.31, 1);
        property <float> sk: mod(i * 0.5698403 + 0.07, 1);
        property <bool> near: sk > 0.9;
        // A few out-of-focus discs with a brighter rim, as a lens draws them.
        property <bool> disc: !near && sk > 0.7;
        property <float> rise: 0.008 + 0.02 * mod(i * 0.3247179, 1);
        property <length> d: near ? (80px + sk * 70px) * S.k : disc ? (22px + sk * 20px) * S.k : (4px + sk * sk * 22px) * S.k;
        property <color> c: mod(i, 4) == 0 ? root.cool : root.warm;
        width: d; height: d;
        border-radius: d / 2;
        x: parent.width * mod(sx + 0.025 * sin(root.t * (6 + mod(i * 7, 9)) * 1deg + i * 40deg), 1) - d / 2;
        y: parent.height * (1.1 - mod(sy + root.t * rise, 1.2)) - d / 2;
        background: near ? @radial-gradient(circle, c.with-alpha(0.16) 0%, c.with-alpha(0) 70%)
            : disc ? @radial-gradient(circle, c.with-alpha(0.22) 0%, c.with-alpha(0.32) 60%, c.with-alpha(0.08) 72%, c.with-alpha(0) 75%)
            : @radial-gradient(circle, c.with-alpha(1) 0%, c.with-alpha(0.6) 30%, c.with-alpha(0) 70%);
        opacity: 0.35 + 0.65 * (0.5 + 0.5 * sin(root.t * (24 + mod(i * 13, 40)) * 1deg + i * 57deg));
    }
}

// Someone's avatar: their picture in a circle, or their initial on their colour.
export component AvatarCircle inherits Rectangle {
    in property <string> initial;
    in property <color> tint: Theme.accent;
    in property <image> picture;
    in property <bool> has-picture;
    in property <length> size: (56px * S.k);
    in property <bool> ring;
    width: size; height: size;
    border-radius: size / 2;
    clip: true;
    background: @linear-gradient(135deg, tint.brighter(0.35) 0%, tint.darker(0.45) 100%);
    animate background { duration: 260ms; }
    if !has-picture: Text { text: root.initial; font-size: root.size * 0.43; font-weight: 600; color: #ffffff; }
    if has-picture: Image { source: root.picture; width: parent.width; height: parent.height; image-fit: cover; }
    if ring: Rectangle { border-radius: parent.border-radius; border-width: max(2px, root.size * 0.03); border-color: #f5f7fb; }
}

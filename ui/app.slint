import { S, Theme, Icons, Zone, DownloadData, DlTab, DlChoice, SetupFile, BootStep, OsiDisk, WjKey, ChipData, ActionData, TileData, HeroData, CardData, CardRow, GenreChip, Fact, FactRow, Shot, HubData, WidgetData, ToastData, NoteRow, PickRow, StorageColors, SettingData, SettingSection, MenuItem, RunningData } from "theme.slint";
import { FocusRing, Chip, Btn, Kicker, Badge, Switch, KeyCap, KeyboardKey, BackButton, Shimmer, Cover } from "widgets.slint";
import { DownloadsPage, DownloadConsent, DownloadPanel, Capsule } from "downloads.slint";
import { LibraryFilter, LibrarySortPicker } from "library.slint";
import { AboutSlint, Palette } from "std-widgets.slint";

export { S, Theme, Zone }
export { OverlayWindow } from "overlay.slint";

// One layer of the Home hero. Two of these crossfade on every selection change.
component HeroView inherits Rectangle {
    in property <HeroData> data;
    in property <bool> front;
    in property <int> focus-idx: -1;
    in property <length> base-y;
    callback action(int);
    // Incoming details rise into place; outgoing ones fade quickly and drift down.
    y: base-y + (front ? 0 : (18px * S.k));
    opacity: front ? 1 : 0;
    visible: self.opacity > 0.01;
    animate y { duration: front ? 380ms : 160ms; easing: ease-out-expo; }
    animate opacity { duration: front ? 300ms : 140ms; easing: ease-out-quad; }
    VerticalLayout {
        alignment: end;
        spacing: 0;
        // Like a console's home: the game's art, its logo and the buttons. The blurb, the
        // facts and the play time are in the Game Hub under it; only a live state shows here.
        if data.kicker-accent != "": Kicker { text: ""; accent: data.kicker-accent; live: data.kicker-live; }
        if data.kicker-accent != "": Rectangle { height: (14px * S.k); }
        if data.has-logo: Image {
            source: data.logo;
            width: data.logo-w;
            height: data.logo-h;
            image-fit: contain;
        }
        if !data.has-logo: Text {
            text: data.title;
            font-size: (64px * S.k);
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            max-width: (820px * S.k);
            max-height: (160px * S.k);
        }
        Rectangle { height: (36px * S.k); }
        HorizontalLayout {
            spacing: (16px * S.k);
            alignment: start;
            for a[i] in data.actions: Btn {
                data: a;
                focused: root.front && root.focus-idx == i;
                dim: root.front && root.focus-idx >= 0 && root.focus-idx != i;
                clicked => { root.action(i); }
            }
        }
        // Something about this game (it crashed, it couldn't start), as in its Game Hub.
        if data.note != "": HorizontalLayout {
            padding-top: (16px * S.k);
            padding-left: (8px * S.k);
            spacing: (10px * S.k);
            alignment: start;
            if data.note-warn: Image { source: Icons.alert; colorize: Theme.warn; width: (20px * S.k); height: (20px * S.k); y: (2px * S.k); }
            // Two lines at most (an error's text can be long).
            Text { text: data.note; font-size: (19px * S.k); color: data.note-warn ? Theme.warn : Theme.text2; wrap: word-wrap; max-width: (780px * S.k); max-height: (52px * S.k); overflow: elide; }
        }
    }
}

// A theme's wallpaper (Settings → Theme): colour fields with a soft light, or your picture.
component Wallpaper inherits Rectangle {
    in property <int> kind;
    in property <image> image;
    background: kind == 2 ? @linear-gradient(170deg, #1b2140 0%, #0b0e1d 55%, #04050b 100%)
        : kind == 3 ? @linear-gradient(135deg, #0f766e 0%, #1e3a8a 48%, #4c1d95 100%)
        : kind == 4 ? @linear-gradient(135deg, #9a3412 0%, #9f1239 45%, #1e1b4b 100%)
        : @linear-gradient(160deg, #0b4fd6 0%, #0a2a7a 45%, #030a24 100%);
    if kind != 5: Rectangle {
        background: @radial-gradient(circle, #ffffff2e 0%, #ffffff00 60%);
        x: parent.width * 0.42; y: -parent.height * 0.35;
        width: parent.width * 0.9; height: parent.height * 1.1;
    }
    if kind == 5: Image { source: root.image; width: parent.width; height: parent.height; image-fit: cover; }
}

export component AppWindow inherits Window {
    title: "SwarmPlay";
    icon: @image-url("../assets/icons/app-icon.svg");
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: (22px * S.k);
    // No preferred size: the window's size comes from the window manager / place_window, and the
    // UI scale follows it (see App::fit_scale). A preferred size would fight every rescale.
    min-width: 640px;
    min-height: 360px;
    // The UI is always dark: keep std widgets (AboutSlint's logo) on the dark variant.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // ---------------------------------------------------------------- state from Rust
    in property <int> view;          // 0 home, 1 library
    in property <int> overlay;       // 0 none, 1 hub, 2 settings, 3 viewer, 4 launch, 5 menu
    in property <int> zone;
    in property <int> idx;
    in property <string> clock;
    // The Game Hub's sections peeking under Home (title, a line about it); none: not shown.
    in property <[Fact]> home-peek;
    // On AzrakOS (the launcher is the whole system): Power shuts down instead of quitting.
    in property <bool> on-os;
    // A laptop's battery (src/battery.rs): shown next to the clock when the PC has one.
    in property <bool> battery-shown;
    in property <int> battery-percent;
    in property <bool> battery-plugged;
    in property <string> app-version;
    in property <RunningData> running;
    in property <string> status;
    in property <bool> status-busy;
    in property <[DownloadData]> downloads;
    in property <bool> download-consent;
    in property <bool> download-is-install;
    in-out property <bool> download-focus-path;
    in property <string> download-title;
    in property <string> download-error;
    in property <string> download-privacy;
    in property <string> download-install-note;
    in property <string> download-warning;
    in-out property <string> download-path;
    in-out property <bool> download-editing;
    // The Downloads page: the selected download, the button with focus (-1: the shelf), the filter.
    in property <int> download-sel;
    in property <int> download-focus-btn: -1;
    in property <[DlTab]> download-tabs;
    in property <int> download-filter;
    in property <length> download-shelf-x;
    in property <string> download-down;
    in property <string> download-up;
    in property <string> download-vpn;
    in property <int> download-vpn-kind;
    in property <bool> download-has-any;
    in property <string> download-empty-title;
    in property <string> download-page-note;
    in property <image> download-glass;
    in property <bool> download-delete-open;
    in property <string> download-delete-title;
    in property <[DlChoice]> download-delete-choices;
    in property <int> download-delete-sel;
    in property <bool> download-has-glass;
    in property <image> setup-glass;
    in property <bool> setup-has-glass;
    // The Download & install panel.
    in property <string> setup-title;
    in property <string> setup-vpn;
    in property <bool> setup-vpn-ok;
    in property <int> setup-state;
    in property <string> setup-message-title;
    in property <string> setup-message;
    in property <[SetupFile]> setup-files;
    in property <string> setup-count;
    in property <string> setup-total;
    in property <int> setup-all-state;
    in property <string> setup-notice;
    in property <int> setup-notice-kind;
    in-out property <string> setup-dl-path;
    in-out property <string> setup-inst-path;
    in property <string> setup-dl-line;
    in property <float> setup-dl-frac;
    in property <bool> setup-dl-bad;
    in property <string> setup-inst-line;
    in property <float> setup-inst-frac;
    in property <bool> setup-inst-bad;
    in property <string> setup-go-label;
    in property <bool> setup-go-enabled;
    in property <int> setup-focus-row: -1;
    in property <int> setup-focus-item;
    in property <int> setup-edit;
    in-out property <bool> setup-editing;
    in property <bool> pad-hints;
    // Trailer player: video frames come from libmpv through an OpenGL texture (src/trailer.rs).
    in property <image> trailer-frame;
    in property <string> trailer-title;
    in property <float> trailer-progress;
    in property <string> trailer-time;
    in property <bool> trailer-paused;
    in property <bool> trailer-loading;
    in property <bool> trailer-controls;
    in property <image> bg-a;
    in property <image> bg-b;
    in property <bool> bg-show-b;
    in property <bool> bg-dim;

    in property <[TileData]> tiles;
    in property <int> sel;
    in property <string> row-name;
    in property <string> row-name-b;
    in property <string> row-sub-b;
    in property <bool> row-front-b;
    in property <string> row-sub;
    in property <HeroData> hero;
    in property <HeroData> hero-b;
    in property <bool> hero-front-b;

    in-out property <string> query;
    in property <string> sort-label;
    in property <string> count-label;
    in property <string> peer-snapshot-label;
    in property <string> search-note;                 // nothing matched as typed: what was searched for instead
    in property <[string]> sort-options;
    in property <int> sort-selected;
    in property <bool> library-compact;
    in property <float> library-type-scale: 1;
    in property <length> library-top: (324px * S.k);
    in property <[GenreChip]> status-filters;
    property <length> library-sort-anchor: (96px * S.k) + library-search.width + (18px * S.k);
    in property <[GenreChip]> genres;
    in property <length> genres-x;
    in property <bool> genres-more-right;
    in property <length> status-filters-end; // right edge of the last status/console chip
    in property <[CardRow]> grid-rows;
    in-out property <length> grid-y;
    in property <duration> grid-glide;
    in property <length> grid-h;
    in property <length> card-w;
    in property <length> row-h;
    in property <length> grid-gap;
    in property <string> grid-empty;

    in property <HubData> hub;
    in property <bool> hub-open;
    // The Hub was opened from Home's cards: it rises from under Home, as the page scrolling on.
    in property <bool> hub-scrolled;
    // The overlay fading out before it closes (src/app.rs back_soft), by its number; 0 none.
    in property <int> closing;
    // The Hub waits to come in until it's at the section it opens on; it goes out before closing.
    in property <bool> hub-ready: true;
    in property <bool> hub-leaving;
    // How long the Hub's page glides to where it's scrolled (0: follows a touchpad as it moves).
    in property <duration> hub-glide: 420ms;
    callback hub-wheel(float);
    // The Welcome tile is selected: its widgets (src/welcome.rs) show in place of a game's hero.
    in property <bool> home-welcome;
    // Settings → Theme's wallpaper (src/theme.rs): 0 the game's art, else one of Wallpaper's.
    in property <int> wallpaper-kind;
    in property <image> wallpaper-image;
    // Settings shows its first page (the list of sections), else a section's page.
    in property <bool> settings-root: true;
    in property <[WidgetData]> welcome;
    callback home-wheel(float);
    // How far Home has scrolled up: enough to show the Hub's cards whole while one is chosen,
    // and on under the Hub that rises over it.
    property <length> home-lift: root.view != 0 ? 0
        : root.overlay == 0 && root.zone == Zone.home-peek ? (92px * S.k)
        : root.hub-open && root.hub-scrolled ? (root.hub-leaving ? (92px * S.k) : root.height * 0.4)
        : 0;
    in property <bool> home-has-game: true;
    in-out property <length> hub-content-h;
    out property <length> hub-text-w: min((1560px * S.k), root.width - (192px * S.k));
    // Where the Hub's sections start in its page (they report it; Rust scrolls to them).
    in-out property <length> hub-at-versions;
    in-out property <length> hub-at-shots;
    in-out property <length> hub-at-details;
    in-out property <length> hub-at-about;
    in-out property <length> hub-col-h;
    out property <length> hub-view-h: root.height;
    in-out property <length> hub-y;
    in property <length> shots-x;

    in property <[SettingData]> settings;
    // The top bar's download ring: 0 none, 1 downloading, 2 installing, 3 needs you, 4 verifying,
    // 5 ready (finished while Downloads was closed); its words,
    // its arc (SVG path on a 36×36 box), and the art behind the bar, blurred, for its glass.
    in property <int> ring-kind;
    // The top bar's avatar: the first letter of who's signed in.
    in property <string> user-initial: "?";
    in property <string> user-name;
    in property <string> ring-label;
    in property <string> ring-suffix;
    in property <string> ring-sizer;
    in property <string> ring-path: "M 18 3";
    in property <image> bar-glass;
    in property <bool> bar-has-glass;
    in-out property <length> settings-y;
    // Settings' left column: its sections, the one shown, and the rows under them (Quit).
    in property <[SettingSection]> settings-sections;
    // Updates wants you (an update ready, a restart to finish one): a dot on the top bar's gear.
    in property <bool> settings-dot;
    in property <int> settings-section;
    in property <string> settings-title;
    in property <string> settings-sub;
    in property <[SettingData]> settings-footer;
    in property <string> settings-version;
    // The art behind the sheet, blurred, for its glass.
    in property <image> settings-glass;
    in property <bool> settings-has-glass;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;

    in property <image> viewer-image;
    in property <string> viewer-count;

    in property <image> launch-bg;
    in property <image> launch-icon;
    in property <string> launch-name;
    in property <string> launch-sub: @tr("Starting with KytyPS5…");
    // Which controller the game will get; without one, the keyboard layout is shown.
    in property <string> launch-controller;
    in property <bool> launch-keyboard;
    // PS4 games run on shadPS4, whose keyboard layout differs from KytyPS5's.
    in property <bool> launch-ps4;
    in property <bool> controls-ps4;
    // Install AzrakOS from the USB stick (os/install.rs). Phase: 0 welcome, 1 disk, 2 last check,
    // 3 installing, 4 done, 5 failed. Buttons are numbered from osi-button-base (after the disks).
    in property <int> osi-phase;
    in property <string> osi-title;
    // The disk's name and size under the title (last check); osi-text-warn: Windows is on it.
    in property <string> osi-sub;
    in property <string> osi-text;
    in property <bool> osi-text-warn;
    // Installed, and Secure Boot's blue key screen (MokManager) comes at the restart.
    in property <bool> osi-mok;
    in property <string> osi-note;
    in property <string> osi-small;
    in property <int> osi-sel;
    in property <float> osi-progress;
    in property <bool> osi-busy;
    in property <[OsiDisk]> osi-disks;
    in property <[string]> osi-buttons;
    in property <int> osi-button-base;
    // Joining a secured Wi-Fi network (os/wifi_join.rs): the field shows dots unless wj-show.
    in property <string> wj-ssid;
    in property <string> wj-sub;
    in property <string> wj-field;
    in property <bool> wj-show;
    in property <string> wj-error;
    in property <string> wj-note;          // not tried yet (too short): said gently, not in red
    in property <bool> wj-enter-joins;     // a keyboard's Enter joins now (after typing, or on Join)
    in property <bool> wj-busy;
    in property <[WjKey]> wj-row0;
    in property <[WjKey]> wj-row1;
    in property <[WjKey]> wj-row2;
    in property <[WjKey]> wj-row3;
    in property <[WjKey]> wj-row4;
    // The Library's search on a controller (search_keys.rs): the field is `query`.
    in property <[WjKey]> sk-suggestions;
    in property <string> sk-suggestions-label;   // "Recent searches" or "Best matches"
    in property <[WjKey]> sk-row1;
    in property <[WjKey]> sk-row2;
    in property <[WjKey]> sk-row3;
    in property <[WjKey]> sk-row4;
    in property <[WjKey]> sk-actions;
    in property <string> sk-count;               // "12 games", or what a typo searched for instead
    in property <bool> sk-count-warn;
    in property <bool> sk-enter-done;            // a keyboard's Enter shows the results now
    // "Restart now?" / "Shut down now?" (os/power.rs): busy once confirmed, with no buttons.
    in property <string> power-title;
    in property <string> power-text;
    in property <[string]> power-buttons;
    in property <bool> power-danger;
    in property <int> power-sel;
    in property <bool> power-busy;

    in property <string> menu-title;
    // The gallery's picture shown, by its place among the Hub's screenshots.
    in property <int> viewer-index;
    callback viewer-step(int);
    in property <[MenuItem]> menu-items;
    // Where the Options menu opens: 0 the middle, 1 beside Home's ··· button, 2 the bottom right
    // corner (Power, from the Control Center).
    in property <int> menu-anchor;
    // Notifications (src/toast.rs): the cards showing (newest first), how many are unread and
    // the newest one's title (the Control Center's card), and the list.
    in property <[ToastData]> toasts;
    in property <int> notif-count;
    in property <string> notif-last;
    in property <[NoteRow]> notes;
    // The drive and folder picker (src/folder_pick.rs, overlay 18): step 0 the drives, 1 a folder.
    in property <string> pick-title;
    in property <string> pick-path;
    in property <string> pick-note;
    in property <int> pick-step;
    in property <[PickRow]> pick-rows;
    callback toast-click(int);

    in property <bool> boot-first;
    // Started with "Try AzrakOS" on the USB stick, right after "Welcome to AzrakOS": this screen
    // carries on from it instead of welcoming again.
    in property <bool> boot-stick;
    in property <bool> boot-ready;
    in property <float> boot-progress;
    in property <string> boot-status;
    in property <string> boot-detail;
    in property <[BootStep]> boot-steps;
    in property <[image]> boot-covers;

    // ---------------------------------------------------------------- callbacks to Rust
    callback key(string, bool, bool, bool) -> bool;   // text, ctrl, alt, repeat
    callback click(int, int);                         // zone, index
    callback hover(int, int);                         // zone, index: the mouse moved onto it
    callback row-wheel(float);
    callback grid-scrolled();
    callback grid-wheel(float);
    callback resized();
    callback search-edited(string);
    callback search-done(bool);                       // accepted (Enter)
    callback edit-done(string, bool);
    callback download-confirm();
    callback download-action(string, string);
    callback trailer-action(string);                // toggle, close, controls, seek:<0..1>
    callback download-close();
    callback download-select(int);
    callback download-delete-choose(int);
    callback download-filter-clicked(int);
    callback setup-toggle(int);
    callback setup-go();
    callback setup-cancel();
    callback setup-change(int);
    callback setup-edit-done();
    callback setup-edit-left(int);
    // Settings' Back hint clicked: as Esc or ○.
    callback settings-back();
    callback hub-release(int);
    callback genres-scroll(int);
    in-out property <bool> hub-details-open;

    public function focus-root() { scope.focus(); }
    public function focus-search() { search-input.focus(); search-input.select-all(); }
    // After type-to-search put the first letter in: keep typing after it, not over it. Offsets
    // are UTF-8 bytes (4 per character at most) and clamped to the end of the text.
    public function search-cursor-to-end() { search-input.set-selection-offsets(root.query.character-count * 4, root.query.character-count * 4); }

    changed width => { root.resized(); }
    changed height => { root.resized(); }

    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            return root.key(e.text, e.modifiers.control, e.modifiers.alt, e.repeat) ? EventResult.accept : EventResult.reject;
        }

        // ------------------------------------------------------------ background
        Rectangle {
            background: @radial-gradient(circle, #13204a 0%, Theme.bg 70%);
        }
        Image {
            source: root.bg-a;
            width: root.width;
            height: root.height;
            image-fit: cover;
            opacity: root.bg-show-b ? 0 : 1;
            // The incoming backdrop settles from a slight zoom while it fades in.
            transform-scale: root.bg-show-b ? 1.06 : 1.0;
            animate opacity { duration: 520ms; easing: ease-out-quad; }
            animate transform-scale { duration: root.bg-show-b ? 0ms : 1600ms; easing: ease-out-quint; }
        }
        Image {
            source: root.bg-b;
            width: root.width;
            height: root.height;
            image-fit: cover;
            opacity: root.bg-show-b ? 1 : 0;
            transform-scale: root.bg-show-b ? 1.0 : 1.06;
            animate opacity { duration: 520ms; easing: ease-out-quad; }
            animate transform-scale { duration: root.bg-show-b ? 1600ms : 0ms; easing: ease-out-quint; }
        }
        // The theme's wallpaper on Welcome (a game's tile always shows the game's art).
        Wallpaper {
            kind: root.wallpaper-kind;
            image: root.wallpaper-image;
            opacity: root.wallpaper-kind > 0 && root.view == 0 && root.home-welcome && root.overlay == 0 ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 420ms; easing: ease-out-quad; }
        }
        Rectangle { background: @linear-gradient(90deg, #04060ef0 0%, #04060eb8 30%, #04060e2e 62%, #04060e00 80%); }
        Rectangle { background: @linear-gradient(0deg, #04060ef5 0%, #04060e59 38%, #04060e00 60%); }
        Rectangle { background: @linear-gradient(180deg, #04060ed9 0%, #04060e00 26%); }
        Rectangle {
            background: #04060e;
            opacity: root.bg-dim ? 0.84 : 0;
            animate opacity { duration: 300ms; }
        }

        // ------------------------------------------------------------ HOME
        home := Rectangle {
            opacity: root.view == 0 ? 1 : 0;
            visible: self.opacity > 0;
            x: root.view == 0 ? 0 : -(40px * S.k);
            y: -root.home-lift;
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate x { duration: 420ms; easing: ease-out-expo; }
            animate y { duration: 460ms; easing: ease-out-expo; }

            // The wheel scrolls Home like a page (down to the cards, then into the Hub). Under
            // everything: the tile row's own wheel and the buttons come first.
            TouchArea {
                scroll-event(e) => {
                    root.home-wheel(e.delta-y / 1px);
                    return EventResult.accept;
                }
            }

            // Tile row: the selected tile is larger with its name beside it (PS5 home).
            property <length> big: (172px * S.k);
            property <length> small: (112px * S.k);
            property <length> gap: (22px * S.k);
            property <length> x0: (96px * S.k);
            property <length> label-w: min((560px * S.k), max(row-name-t.preferred-width, row-sub-t.preferred-width)) + gap * 2.6;

            Rectangle {
                y: (128px * S.k);
                height: (210px * S.k);
                // Scrolled off under the tabs while Home is scrolled down.
                opacity: root.home-lift > 0 ? 0 : 1;
                animate opacity { duration: 220ms; easing: ease-out-quad; }
                for t[i] in root.tiles: Rectangle {
                    x: i < root.sel ? home.x0 - (root.sel - i) * (home.small + home.gap) - home.gap
                        : i == root.sel ? home.x0 : home.x0 + home.big + home.label-w + (i - root.sel - 1) * (home.small + home.gap);
                    y: 0;
                    width: i == root.sel ? home.big : home.small;
                    height: self.width;
                    opacity: i < root.sel ? 0 : 1;
                    visible: self.x < root.width + (40px * S.k) && i >= root.sel - 2;
                    animate x, width { duration: 360ms; easing: ease-out-expo; }
                    animate opacity { duration: 220ms; easing: ease-out-quad; }
                    FocusRing { w: parent.width; h: parent.height; on: i == root.sel && root.zone == Zone.row && root.overlay == 0; radius: (18px * S.k); }
                    Rectangle {
                        border-radius: (18px * S.k);
                        clip: true;
                        background: t.welcome ? @linear-gradient(135deg, Theme.accent.darker(0.45) 0%, Theme.accent 60%, Theme.accent.brighter(0.35) 100%)
                            : t.special ? #ffffff1f : Theme.panel;
                        border-width: t.special ? 1px : 0;
                        border-color: Theme.line;
                        drop-shadow-blur: 0;
                        if t.welcome: Image {
                            source: Icons.sparkle;
                            colorize: #ffffff;
                            width: parent.width * 0.4;
                            height: self.width;
                        }
                        if !t.special && !t.welcome: Image {
                            source: t.image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: t.loaded ? 1 : 0;
                            animate opacity { duration: 250ms; }
                        }
                        if t.special: Image {
                            source: Icons.grid;
                            colorize: Theme.text;
                            width: parent.width * 0.42;
                            height: self.width;
                        }
                    }
                    if t.badge != "": Badge {
                        x: (10px * S.k);
                        y: parent.height - self.height - (10px * S.k);
                        text: t.badge;
                        size: i == root.sel ? (13px * S.k) : (10px * S.k);
                    }
                    Rectangle {
                        border-radius: (18px * S.k);
                        border-width: t.badge == "Playing" ? (3px * S.k) : 0;
                        border-color: Theme.ok;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.click(Zone.row, i); }
                    }
                }
                // Name beside the selected tile: sized by the front slot; the two slots crossfade.
                row-name-t := Text { visible: false; text: root.row-front-b ? root.row-name-b : root.row-name; font-size: (30px * S.k); font-weight: 500; }
                row-sub-t := Text { visible: false; text: root.row-front-b ? root.row-sub-b : root.row-sub; font-size: (18px * S.k); }
                for slot in [0, 1]: Rectangle {
                    property <bool> front: (slot == 1) == root.row-front-b;
                    x: home.x0 + home.big + home.gap * 1.2 + (front ? 0 : (14px * S.k));
                    y: 0;
                    height: home.big;
                    width: min((560px * S.k), max(row-name-t.preferred-width, row-sub-t.preferred-width));
                    opacity: front ? 1 : 0;
                    animate opacity { duration: front ? 280ms : 120ms; easing: ease-out-quad; }
                    animate x { duration: front ? 360ms : 120ms; easing: ease-out-expo; }
                    VerticalLayout {
                        alignment: center;
                        spacing: (6px * S.k);
                        Text { text: slot == 0 ? root.row-name : root.row-name-b; font-size: (30px * S.k); font-weight: 500; color: Theme.text; overflow: elide; }
                        Text { text: slot == 0 ? root.row-sub : root.row-sub-b; font-size: (18px * S.k); color: Theme.text2; overflow: elide; }
                    }
                }
                TouchArea {
                    scroll-event(e) => {
                        root.row-wheel((e.delta-y + e.delta-x) / 1px);
                        return EventResult.accept;
                    }
                }
            }

            // No games yet: the welcome screen's calm backdrop (no game's art, which would read as
            // an ad or as a game you own) and the way to a first game.
            if !root.home-has-game: Rectangle {
                property <HeroData> h: root.hero-front-b ? root.hero-b : root.hero;
                background: #05070f;
                Rectangle {
                    x: root.width * 0.30 - self.width / 2;
                    y: root.height * 0.38 - self.height / 2;
                    width: (1100px * S.k);
                    height: self.width;
                    background: @radial-gradient(circle, #1f4fd13d 0%, #1f4fd100 65%);
                }
                Rectangle {
                    x: root.width * 0.72 - self.width / 2;
                    y: root.height * 0.62 - self.height / 2;
                    width: (1000px * S.k);
                    height: self.width;
                    background: @radial-gradient(circle, #8b5cf62e 0%, #8b5cf600 65%);
                }
                VerticalLayout {
                    x: (96px * S.k);
                    y: (300px * S.k);
                    width: root.width - (192px * S.k);
                    height: self.preferred-height;
                    spacing: 0;
                    Image { source: Icons.app; width: (88px * S.k); height: (88px * S.k); image-fit: contain; }
                    Rectangle { height: (36px * S.k); }
                    Text { text: h.title; font-size: (72px * S.k); font-weight: 700; color: Theme.text; }
                    Rectangle { height: (18px * S.k); }
                    Text { text: h.desc; font-size: (30px * S.k); color: Theme.text2; wrap: word-wrap; }
                    Rectangle { height: (10px * S.k); }
                    Text { text: @tr("Already have games on this PC? Add the folder they're in."); font-size: (21px * S.k); color: Theme.text3; wrap: word-wrap; }
                    Rectangle { height: (40px * S.k); }
                    HorizontalLayout {
                        spacing: (16px * S.k);
                        alignment: start;
                        for a[i] in h.actions: Btn {
                            data: a;
                            focused: root.zone == Zone.actions && root.overlay == 0 && root.idx == i;
                            dim: root.zone == Zone.actions && root.overlay == 0 && root.idx != i;
                            clicked => { root.click(Zone.actions, i); }
                        }
                    }
                }
            }

            // Hero: two layers crossfade when the selection changes (the new game's details
            // rise in while the old ones fade), like the PS5 home screen.
            if root.home-has-game && !root.home-welcome: Rectangle {
            for slot in [0, 1]: HeroView {
                x: (96px * S.k);
                width: (900px * S.k);
                base-y: (360px * S.k);
                height: root.height - (360px * S.k) - (root.home-peek.length > 0 ? (196px * S.k) : (112px * S.k));
                data: slot == 0 ? root.hero : root.hero-b;
                front: (slot == 1) == root.hero-front-b;
                focus-idx: root.zone == Zone.actions && root.overlay == 0 ? root.idx : -1;
                action(i) => { root.click(Zone.actions, i); }
            }
            }
            // The Game Hub's cards peek at the bottom (Down reaches them; each opens the Hub there).
            // Welcome: six widgets, three by two, on glass over the wallpaper.
            if root.home-has-game && root.home-welcome: Rectangle {
                property <length> gap: (20px * S.k);
                property <length> w: root.width - (192px * S.k);
                property <length> cw: (self.w - self.gap * 2) / 3;
                property <length> ch: min((210px * S.k), (root.height - (430px * S.k) - (110px * S.k)) / 2);
                x: (96px * S.k);
                y: (410px * S.k);
                width: self.w;
                height: self.ch * 2 + self.gap;
                for wd[i] in root.welcome: widget := Rectangle {
                    property <bool> f: root.zone == Zone.welcome && root.idx == i && root.overlay == 0;
                    property <color> tone: wd.kind == 1 ? Theme.ok : wd.kind == 2 ? Theme.warn : wd.kind == 3 ? Theme.danger : Theme.text;
                    x: mod(i, 3) * (parent.cw + parent.gap);
                    y: floor(i / 3) * (parent.ch + parent.gap) - (f ? (8px * S.k) : 0);
                    width: parent.cw;
                    height: parent.ch;
                    animate y { duration: 260ms; easing: ease-out-expo; }
                    // They come in one after another when the Welcome is chosen.
                    property <bool> shown: false;
                    init => { self.shown = true; }
                    opacity: self.shown ? 1 : 0;
                    transform-scale: !self.shown ? 0.94 : ta-w.pressed ? 0.97 : 1;
                    animate opacity { duration: 360ms; delay: i * 45ms; easing: ease-out-quad; }
                    animate transform-scale { duration: 480ms; delay: ta-w.has-hover ? 0ms : i * 45ms; easing: ease-out-expo; }
                    Rectangle {
                        border-radius: (22px * S.k);
                        background: widget.f ? #ffffff2b : ta-w.has-hover ? #ffffff1a : #0a0f1d8c;
                        border-width: 1px;
                        border-color: widget.f ? #ffffff00 : #ffffff1f;
                        animate background { duration: 200ms; }
                    }
                    FocusRing { w: parent.width; h: parent.height; on: widget.f; radius: (22px * S.k); glow: false; }
                    VerticalLayout {
                        padding: (24px * S.k);
                        spacing: (6px * S.k);
                        alignment: start;
                        HorizontalLayout {
                            spacing: (12px * S.k);
                            alignment: start;
                            Rectangle {
                                width: (40px * S.k); height: self.width;
                                border-radius: self.width / 2;
                                background: #ffffff1a;
                                Image {
                                    source: wd.icon == 0 ? Icons.gamepad : wd.icon == 1 ? Icons.disk : wd.icon == 2 ? Icons.download
                                        : wd.icon == 3 ? Icons.sparkle : wd.icon == 4 ? Icons.grid : Icons.gear;
                                    colorize: Theme.text;
                                    width: (22px * S.k); height: self.width;
                                }
                            }
                            Text { text: wd.title; font-size: (18px * S.k); font-weight: 600; color: Theme.text2; vertical-alignment: center; }
                        }
                        Rectangle { height: (6px * S.k); }
                        Text { text: wd.value; font-size: (32px * S.k); font-weight: 700; color: widget.tone; overflow: elide; }
                        Text { text: wd.sub; font-size: (17px * S.k); color: Theme.text2; overflow: elide; }
                        if wd.progress >= 0: Rectangle {
                            height: (6px * S.k);
                            Rectangle { y: (4px * S.k); height: (6px * S.k); border-radius: (3px * S.k); background: #ffffff1f; }
                            Rectangle {
                                x: 0; y: (4px * S.k);
                                width: parent.width * clamp(wd.progress, 0, 1);
                                height: (6px * S.k);
                                border-radius: (3px * S.k);
                                background: widget.tone == Theme.text ? Theme.accent : widget.tone;
                                animate width { duration: 400ms; }
                            }
                        }
                    }
                    ta-w := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.welcome, i); } }
                }
            }
            if root.home-peek.length > 0 && !root.home-welcome: HorizontalLayout {
                x: (96px * S.k);
                y: root.height - (96px * S.k);
                width: root.width - (192px * S.k);
                height: (150px * S.k);
                spacing: (18px * S.k);
                for p[i] in root.home-peek: peek-card := Rectangle {
                    property <bool> f: root.zone == Zone.home-peek && root.idx == i && root.overlay == 0;
                    // Equal columns, whatever their text.
                    width: (root.width - (192px * S.k) - (54px * S.k)) / 4;
                    y: f ? -(14px * S.k) : ta-peek.has-hover ? -(6px * S.k) : 0;
                    // Pressed in, then the Hub rises from it (and it rises with Home).
                    transform-scale: ta-peek.pressed ? 0.97 : root.hub-open && root.hub-scrolled && f ? 1.03 : 1;
                    animate y { duration: 260ms; easing: ease-out-expo; }
                    animate transform-scale { duration: 220ms; easing: ease-out-quad; }
                    // Glass over the game's art: lighter when chosen, with the ring (no halo, which
                    // would fill the card) around it.
                    Rectangle {
                        border-radius: (18px * S.k);
                        background: peek-card.f ? #ffffff26 : ta-peek.has-hover ? #ffffff1f : #ffffff12;
                        border-width: 1px;
                        border-color: peek-card.f ? #ffffff00 : #ffffff1f;
                        animate background { duration: 200ms; }
                    }
                    FocusRing { w: parent.width; h: parent.height; on: peek-card.f; radius: (18px * S.k); glow: false; }
                    VerticalLayout {
                        padding-left: (22px * S.k);
                        padding-right: (22px * S.k);
                        padding-top: (18px * S.k);
                        spacing: (4px * S.k);
                        alignment: start;
                        Text { text: p.key; font-size: (19px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: p.value; font-size: (16px * S.k); color: Theme.text2; overflow: elide; }
                    }
                    ta-peek := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.home-peek, i); } }
                }
            }
        }

        // ------------------------------------------------------------ LIBRARY
        Rectangle {
            opacity: root.view == 1 ? 1 : 0;
            visible: self.opacity > 0;
            x: root.view == 1 ? 0 : (40px * S.k);
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate x { duration: 420ms; easing: ease-out-expo; }

            // Grid (virtualized: only rows near the viewport exist).
            // Scrolling is driven from Rust (wheel, touchpad, keyboard, controller) so each input
            // gets the right step and a short glide; only rows near the viewport exist.
            grid := Rectangle {
                y: root.library-top;
                height: root.height - root.library-top;
                width: root.width;
                clip: true;
                TouchArea {
                    scroll-event(e) => {
                        root.grid-wheel(e.delta-y / 1px);
                        return EventResult.accept;
                    }
                }
                Rectangle {
                y: root.grid-y;
                height: root.grid-h;
                animate y { duration: root.grid-glide; easing: ease-out-quart; }
                for r in root.grid-rows: Rectangle {
                    y: r.index * root.row-h + (26px * S.k);
                    height: root.row-h;
                    for c[j] in r.cards: Rectangle {
                        x: (96px * S.k) + j * (root.card-w + root.grid-gap);
                        width: root.card-w;
                        height: root.row-h;
                        property <bool> f: root.zone == Zone.grid && root.idx == c.index && root.overlay == 0;
                        Rectangle {
                            y: 0;
                            height: root.card-w * 1.5;   // official covers are 2:3
                            transform-scale: ta-card.pressed ? 0.97 : f ? 1.05 : ta-card.has-hover ? 1.025 : 1.0;
                            animate transform-scale { duration: 220ms; easing: ease-out-back; }
                            FocusRing { w: parent.width; h: parent.height; on: f; radius: (14px * S.k); }
                            Rectangle {
                                border-radius: (14px * S.k);
                                clip: true;
                                background: Theme.panel;
                                Shimmer { active: !c.loaded && !c.no-art; }
                                Cover { source: c.image; loaded: c.loaded; }
                                // No artwork for this game: its name, on the console's colours.
                                if c.no-art: Rectangle {
                                    background: c.console == "PC" ? @linear-gradient(160deg, #1d3a2f 0%, #0d1714 100%)
                                        : c.console == "PS4" ? @linear-gradient(160deg, #1b2d52 0%, #0b1224 100%)
                                        : @linear-gradient(160deg, #26304f 0%, #0e1222 100%);
                                    Text {
                                        x: parent.width * 0.1;
                                        width: parent.width * 0.8;
                                        text: c.title;
                                        font-size: max((15px * S.k), parent.width * 0.11);
                                        font-weight: 700;
                                        color: #e8ecf6;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Badge { x: (10px * S.k); y: (10px * S.k); text: c.badge; size: (14px * S.k); }
                                if c.compat != "": Rectangle {
                                    x: (10px * S.k);
                                    y: parent.height - self.height - (10px * S.k);
                                    width: cp.preferred-width + (30px * S.k);
                                    height: (28px * S.k);
                                    border-radius: (6px * S.k);
                                    background: #000000c4;
                                    Rectangle {
                                        x: (9px * S.k);
                                        width: (8px * S.k);
                                        height: (8px * S.k);
                                        border-radius: (4px * S.k);
                                        background: Theme.compat-color(c.compat-level);
                                    }
                                    cp := Text {
                                        x: (23px * S.k);
                                        text: c.compat;
                                        font-size: (15px * root.library-type-scale);
                                        font-weight: 700;
                                        color: #ffffff;
                                    }
                                }
                                if c.rating != "": Rectangle {
                                    x: parent.width - self.width - (10px * S.k);
                                    y: parent.height - self.height - (10px * S.k);
                                    width: rt.preferred-width + (16px * S.k);
                                    height: (26px * S.k);
                                    border-radius: (6px * S.k);
                                    background: #000000b8;
                                    rt := Text { text: "★ " + c.rating; font-size: (14px * S.k); font-weight: 700; color: #ffd666; }
                                }
                            }
                        }
                        VerticalLayout {
                            y: root.card-w * 1.5 + (14px * S.k);
                            width: parent.width;
                            height: (102px * root.library-type-scale) + (8px * S.k);
                            alignment: start;
                            spacing: (4px * S.k);
                            // Every card reserves two title lines, including short titles.
                            Rectangle {
                                height: (52px * root.library-type-scale);
                                clip: true;
                                title-t := Text {
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: c.title;
                                    font-size: (20px * root.library-type-scale);
                                    font-weight: 500;
                                    color: f ? #ffffff : Theme.text;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: top;
                                }
                            }
                            HorizontalLayout {
                                height: (26px * root.library-type-scale);
                                spacing: (6px * S.k);
                                // The size fits beside the platforms; only a long "Size unknown" on
                                // the narrowest cards shortens.
                                Text { text: c.meta; font-size: (18px * root.library-type-scale); font-weight: 500; color: Theme.text2; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                // The platforms the game is on, off the cover (one card, every
                                // platform: Hades on PS5, PS4 and PC): filled tags, each in its
                                // colour, PS5 white like the console, PS4 PlayStation blue, PC green.
                                // A one-console Library shows the release count instead.
                                HorizontalLayout {
                                    spacing: (4px * S.k);
                                    for p in c.consoles: Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: pt.preferred-width + (9px * root.library-type-scale);
                                        height: (20px * root.library-type-scale);
                                        border-radius: (5px * root.library-type-scale);
                                        background: p == "PS4" ? #2563eb : p == "PC" ? #15803d : #f1f3f8;
                                        pt := Text {
                                            text: p;
                                            font-size: (13px * root.library-type-scale);
                                            font-weight: 800;
                                            letter-spacing: (0.3px * S.k);
                                            color: p == "PS5" ? #0b1020 : #ffffff;
                                        }
                                    }
                                }
                                if c.consoles.length == 0 && c.releases != "": Text { text: c.releases; font-size: (15px * root.library-type-scale); color: Theme.text3; overflow: elide; }
                            }
                            // How easy it is to download; the seeder counts are in the Game Hub's details.
                            HorizontalLayout {
                                height: (24px * root.library-type-scale);
                                spacing: (6px * S.k);
                                alignment: start;
                                Rectangle {
                                    width: (8px * S.k); height: self.width; y: (parent.height - self.height) / 2;
                                    border-radius: self.width / 2;
                                    background: c.availability-kind == 1 ? Theme.ok : c.availability-kind == 2 ? Theme.warn : Theme.text3;
                                }
                                Text { text: @tr("Availability"); font-size: (16px * root.library-type-scale); color: Theme.text3; overflow: elide; }
                                Text {
                                    text: c.availability;
                                    font-size: (16px * root.library-type-scale);
                                    font-weight: 600;
                                    color: c.availability-kind == 1 ? Theme.ok : c.availability-kind == 2 ? Theme.warn : Theme.text3;
                                }
                            }
                        }
                        ta-card := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.click(Zone.grid, c.index); }
                        }
                    }
                }
                }
            }
            if root.grid-empty != "": Text {
                y: (420px * S.k);
                width: root.width;
                horizontal-alignment: center;
                text: root.grid-empty;
                font-size: (24px * S.k);
                color: Theme.text3;
            }

            // Header: search, sort, count, genre chips.
            Rectangle {
                y: 0;
                height: root.library-top;
                background: @linear-gradient(180deg, #070a14 0%, #070a14 88%, #070a1400 100%);
                HorizontalLayout {
                    x: (96px * S.k);
                    y: (112px * S.k);
                    width: root.width - (192px * S.k);
                    height: (62px * S.k);
                    spacing: (18px * S.k);
                    library-search := Rectangle {
                        width: min((600px * S.k), max((180px * S.k), parent.width - library-sort.width - density.width - (54px * S.k)));
                        border-radius: (31px * S.k);
                        background: root.zone == Zone.search ? #ffffff1f : ta-search.has-hover ? #ffffff17 : #ffffff0f;
                        border-width: root.zone == Zone.search ? (3px * S.k) : 0;
                        border-color: #f5f7fb;
                        animate background { duration: 120ms; }
                        Image { x: (24px * S.k); source: Icons.search; colorize: Theme.text2; width: (24px * S.k); height: (24px * S.k); }
                        search-input := TextInput {
                            x: (62px * S.k);
                            width: parent.width - (86px * S.k);
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: (22px * root.library-type-scale);
                            color: Theme.text;
                            text <=> root.query;
                            single-line: true;
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search-done(true); }
                        }
                        if root.query == "": Text {
                            x: (62px * S.k);
                            text: @tr("Search games");
                            font-size: (22px * root.library-type-scale);
                            color: Theme.text3;
                            vertical-alignment: center;
                        }
                        ta-search := TouchArea {
                            mouse-cursor: text;
                            clicked => { root.click(Zone.search, 0); }
                        }
                    }
                    library-sort := Rectangle {
                        width: sort-row.preferred-width + (40px * S.k);
                        border-radius: (31px * S.k);
                        background: root.zone == Zone.sort ? #ffffff1f : ta-sort.has-hover ? #ffffff17 : #ffffff0f;
                        border-width: root.zone == Zone.sort ? (3px * S.k) : 0;
                        border-color: #f5f7fb;
                        sort-row := HorizontalLayout {
                            spacing: (10px * S.k);
                            alignment: center;
                            Text { text: root.sort-label; font-size: (20px * root.library-type-scale); color: Theme.text; vertical-alignment: center; }
                            Image { source: Icons.chevd; colorize: Theme.text3; width: (20px * S.k); height: (20px * S.k); y: (parent.height - (20px * S.k)) / 2; }
                        }
                        ta-sort := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.sort, 0); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    density := Rectangle {
                        width: density-row.preferred-width;
                        border-radius: (31px * S.k); background: #ffffff0f;
                        density-row := HorizontalLayout {
                            padding: (5px * S.k); spacing: (4px * S.k);
                            for label[i] in [root.width < 1000px ? @tr("Roomy") : @tr("Comfortable"), @tr("Compact")]: Rectangle {
                                width: dt.preferred-width + (28px * S.k);
                                border-radius: (26px * S.k);
                                property <bool> chosen: root.library-compact == (i == 1);
                                background: chosen ? #ffffff24 : transparent;
                                border-width: root.zone == Zone.density && root.idx == i && root.overlay == 0 ? (3px * S.k) : 0;
                                border-color: #f5f7fb;
                                dt := Text { text: label; font-size: (17px * root.library-type-scale); color: chosen ? Theme.text : Theme.text3; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.density, i); } }
                            }
                        }
                    }
                }
                Rectangle {
                    x: (96px * S.k);
                    y: (192px * S.k);
                    width: root.width - (192px * S.k);
                    height: (52px * S.k);
                    for g in root.status-filters: LibraryFilter {
                        x: g.x; y: (4px * S.k); data: g; type-scale: root.library-type-scale; tab: true;
                        focused: root.zone == Zone.chips && root.idx == g.index && root.overlay == 0;
                        clicked => { root.click(Zone.chips, g.index); }
                    }
                    // The result count, only where it fits beside the chips (narrow windows drop it).
                    Rectangle {
                        x: parent.width - self.width; width: max(count.preferred-width, snapshot.preferred-width);
                        visible: root.status-filters-end + (24px * S.k) <= self.x;
                        VerticalLayout {
                            alignment: center; spacing: (3px * S.k);
                            count := Text { text: root.count-label; font-size: (18px * root.library-type-scale); color: Theme.text2; horizontal-alignment: right; }
                            // A typo: the near spelling searched for stands in for the list's date.
                            snapshot := Text {
                                text: root.search-note != "" ? root.search-note : root.peer-snapshot-label;
                                font-size: (16px * root.library-type-scale); color: root.search-note != "" ? Theme.warn : Theme.text3; horizontal-alignment: right;
                            }
                        }
                    }
                }
                Rectangle {
                    x: (96px * S.k); y: (254px * S.k); width: root.width - (192px * S.k);
                    height: (52px * S.k);
                    Text { x: 0; y: 0; height: parent.height; text: @tr("Genre"); font-size: (17px * root.library-type-scale); font-weight: 500; color: Theme.hint; width: (76px * S.k); horizontal-alignment: left; vertical-alignment: center; }
                    Rectangle {
                        x: (80px * S.k); y: (6px * S.k); width: (36px * S.k); height: (36px * S.k);
                        border-radius: (18px * S.k); background: root.genres-x < 0 ? #ffffff14 : transparent;
                        Image { source: Icons.chevl; colorize: root.genres-x < 0 ? Theme.text : Theme.text3; width: (20px * S.k); height: (20px * S.k); }
                        TouchArea { enabled: root.genres-x < 0; mouse-cursor: pointer; clicked => { root.genres-scroll(-3); } }
                    }
                    Flickable {
                        x: (124px * S.k); width: parent.width - (168px * S.k); height: parent.height;
                        content-x: root.genres-x; interactive: false;
                        for g in root.genres: LibraryFilter {
                            x: g.x; y: (4px * S.k); data: g; type-scale: root.library-type-scale;
                            focused: root.zone == Zone.chips && root.idx == g.index && root.overlay == 0;
                            clicked => { root.click(Zone.chips, g.index); }
                        }
                    }
                    // Chips scrolled past either edge fade out instead of being sliced off.
                    if root.genres-x < 0: Rectangle {
                        x: (124px * S.k); width: (48px * S.k); height: parent.height;
                        background: @linear-gradient(90deg, #070a14, #070a1400);
                    }
                    if root.genres-more-right: Rectangle {
                        x: parent.width - (92px * S.k); width: (48px * S.k); height: parent.height;
                        background: @linear-gradient(90deg, #070a1400, #070a14);
                    }
                    Rectangle {
                        x: parent.width - (36px * S.k); y: (6px * S.k); width: (36px * S.k); height: (36px * S.k);
                        border-radius: (18px * S.k); background: root.genres-more-right ? #ffffff14 : transparent;
                        Image { source: Icons.chevr; colorize: root.genres-more-right ? Theme.text : Theme.text3; width: (20px * S.k); height: (20px * S.k); }
                        TouchArea { enabled: root.genres-more-right; mouse-cursor: pointer; clicked => { root.genres-scroll(3); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ TOP BAR
        Rectangle {
            y: 0;
            height: (104px * S.k);
            HorizontalLayout {
                x: (96px * S.k);
                y: 0;
                height: (104px * S.k);
                spacing: (44px * S.k);
                alignment: start;
                for tab[i] in [@tr("Games"), @tr("Library")]: Rectangle {
                    width: tt.preferred-width + (8px * S.k);
                    property <bool> active: root.view == i;
                    property <bool> f: root.zone == Zone.tabs && root.idx == i && root.overlay == 0;
                    tt := Text {
                        text: tab;
                        font-size: (30px * S.k);
                        font-weight: 500;
                        color: active || f ? Theme.text : Theme.text3;
                        animate color { duration: Theme.fast; }
                    }
                    Rectangle {
                        y: parent.height / 2 + (28px * S.k);
                        width: active ? (28px * S.k) : 0;
                        height: (3px * S.k);
                        border-radius: (2px * S.k);
                        background: #ffffff;
                        animate width { duration: Theme.move; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    }
                    Rectangle {
                        visible: f;
                        x: -(14px * S.k);
                        width: parent.width + (28px * S.k);
                        y: parent.height / 2 - (26px * S.k);
                        height: (52px * S.k);
                        border-radius: (26px * S.k);
                        border-width: (3px * S.k);
                        border-color: #ffffff;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.tabs, i); } }
                }
            }
            // The same distance from the right edge as the tabs from the left.
            HorizontalLayout {
                x: root.width - self.width - (100px * S.k);
                y: 0;
                width: self.preferred-width;
                height: (104px * S.k);
                spacing: (22px * S.k);
                if root.running.active: Rectangle {
                    height: (52px * S.k);
                    y: (26px * S.k);
                    width: pill.preferred-width;
                    border-radius: (26px * S.k);
                    background: #3ddc9724;
                    border-width: 1px;
                    border-color: #3ddc975a;
                    pill := HorizontalLayout {
                        padding-left: (18px * S.k);
                        padding-right: (8px * S.k);
                        spacing: (12px * S.k);
                        Rectangle { width: (10px * S.k); height: (10px * S.k); y: (21px * S.k); border-radius: (5px * S.k); background: Theme.ok; }
                        // Cut short, so the top bar never reaches the tabs.
                        Text { text: root.running.name; max-width: (320px * S.k); overflow: elide; font-size: (18px * S.k); font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Text { text: root.running.note != "" ? root.running.note : root.running.time; max-width: (420px * S.k); overflow: elide; font-size: (18px * S.k); color: root.running.note != "" ? Theme.warn : Theme.text2; vertical-alignment: center; }
                        for b[i] in [@tr("Resume"), @tr("Stop")]: Rectangle {
                            y: (7px * S.k);
                            height: (38px * S.k);
                            width: bt.preferred-width + (28px * S.k);
                            border-radius: (19px * S.k);
                            property <bool> f: root.zone == Zone.top && root.idx == i && root.overlay == 0;
                            background: f ? (i == 1 ? Theme.danger : #ffffff) : #ffffff1f;
                            bt := Text { text: b; font-size: (16px * S.k); font-weight: 600; color: f && i == 0 ? #0a0d18 : #ffffff; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, i); } }
                        }
                    }
                }
                // As on a console: round buttons on their own (Search, Downloads, Settings), then the
                // battery and the clock in plain text. Downloads is the ring while something's
                // happening (what's downloading or installing, what needs you, what just got ready),
                // its icon otherwise; either way in the same place.
                bar := HorizontalLayout {
                    property <color> ring-tint: root.ring-kind == 2 ? #c4b5fd : root.ring-kind == 3 ? #ffb547 : root.ring-kind == 4 ? #5eead4 : root.ring-kind == 5 ? Theme.ok : #8dbaff;
                    y: (20px * S.k);
                    height: (64px * S.k);
                    spacing: (16px * S.k);
                        // Search (the Library's, from anywhere).
                        srch := Rectangle {
                            property <bool> f: root.zone == Zone.top && root.idx == 5 && root.overlay == 0;
                            height: (56px * S.k);
                            y: (4px * S.k);
                            width: self.height;
                            border-radius: self.height / 2;
                            // A plain icon; the one chosen sits in a white circle.
                            background: self.f ? #f5f7fb : ta-srch.has-hover ? #ffffff1f : transparent;
                            animate background { duration: 120ms; }
                            Image { source: Icons.search; colorize: srch.f ? #0a0d18 : Theme.text; width: (30px * S.k); height: self.width; }
                            ta-srch := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, 5); } }
                        }
                        // Downloads: the ring, only while something's happening (the Control Center
                        // has Downloads always).
                        if root.ring-kind > 0: dl := Rectangle {
                            property <bool> f: root.zone == Zone.top && root.idx == 4 && root.overlay == 0;
                            width: max((56px * S.k), dl-row.preferred-width);
                            border-radius: self.height / 2;
                            height: (56px * S.k);
                            y: (4px * S.k);
                            background: self.f ? #f5f7fb : ta-dl.has-hover ? #ffffff2e : #0a0f1d80;
                            border-width: self.f ? 0 : 1px;
                            border-color: #ffffff1f;
                            animate background { duration: 120ms; }
                            dl-row := HorizontalLayout {
                                padding-left: root.ring-kind > 0 ? (14px * S.k) : (16px * S.k);
                                padding-right: root.ring-kind > 0 ? (20px * S.k) : (16px * S.k);
                                spacing: (12px * S.k);
                                if root.ring-kind > 0: Rectangle {
                                    width: (32px * S.k); height: self.width; y: (parent.height - self.height) / 2;
                                    Path {
                                        width: parent.width; height: parent.height;
                                        viewbox-width: 36; viewbox-height: 36;
                                        commands: "M 18 3 A 15 15 0 0 1 18 33 A 15 15 0 0 1 18 3";
                                        stroke: dl.f ? #05070f24 : #ffffff2e;
                                        stroke-width: (3.2px * S.k);
                                    }
                                    Path {
                                        width: parent.width; height: parent.height;
                                        viewbox-width: 36; viewbox-height: 36;
                                        commands: root.ring-path;
                                        stroke: dl.f ? (root.ring-kind == 2 ? #7c5cff : root.ring-kind == 3 ? #d98a00 : root.ring-kind == 4 ? #0f9e8e : root.ring-kind == 5 ? #12a366 : Theme.accent) : bar.ring-tint;
                                        stroke-width: (3.2px * S.k);
                                        stroke-line-cap: round;
                                    }
                                }
                                // The words (a long name is cut short, never the percentage), then the
                                // percentage, as wide as with every digit a 0 so the ring stays put.
                                // (Together: the suffix starts with its own space.)
                                if root.ring-kind > 0: HorizontalLayout {
                                    Text {
                                        text: root.ring-label;
                                        max-width: (300px * S.k); overflow: elide;
                                        font-size: (22px * S.k); font-weight: 600;
                                        color: dl.f ? #05070f : #f5f7fb;
                                        vertical-alignment: center;
                                    }
                                    if root.ring-suffix != "": Rectangle {
                                        width: max(ring-text.preferred-width, ring-sizer.preferred-width);
                                        ring-text := Text {
                                            x: 0; text: root.ring-suffix;
                                            font-size: (22px * S.k); font-weight: 600;
                                            color: dl.f ? #05070f : #f5f7fb;
                                            vertical-alignment: center;
                                        }
                                        ring-sizer := Text { text: root.ring-sizer; font-size: (22px * S.k); font-weight: 600; visible: false; }
                                    }
                                }
                                if root.ring-kind == 0: Image {
                                    y: (parent.height - self.height) / 2;
                                    source: Icons.download; colorize: dl.f ? #0a0d18 : Theme.text2;
                                    width: (28px * S.k); height: self.width;
                                }
                            }
                            ta-dl := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, 4); } }
                        }
                        gear := Rectangle {
                            property <bool> f: root.zone == Zone.top && root.idx == 3 && root.overlay == 0;
                            width: self.height;
                            border-radius: self.height / 2;
                            height: (56px * S.k);
                            y: (4px * S.k);
                            background: self.f ? #f5f7fb : ta-gear.has-hover ? #ffffff1f : transparent;
                            animate background { duration: 120ms; }
                            Image { source: Icons.gear; colorize: gear.f ? #0a0d18 : Theme.text; width: (30px * S.k); height: self.width; }
                            // On the gear's top right, ringed in the bar's colour so it stands off the teeth.
                            if root.settings-dot: Rectangle {
                                x: parent.width / 2 + (7px * S.k); y: parent.height / 2 - (17px * S.k);
                                width: (13px * S.k); height: self.width;
                                border-radius: self.width / 2;
                                background: Theme.warn;
                                border-width: (2.5px * S.k);
                                border-color: gear.f ? #f5f7fb : #00000066;
                            }
                            ta-gear := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, 3); } }
                        }
                        // You: an avatar with your initial; it opens the Control Center (Power is there).
                        av := Rectangle {
                            property <bool> f: root.zone == Zone.top && root.idx == 6 && root.overlay == 0;
                            width: (56px * S.k);
                            height: self.width;
                            y: (4px * S.k);
                            FocusRing { w: parent.width; h: parent.height; on: av.f; radius: parent.width / 2; glow: false; }
                            Rectangle {
                                border-radius: self.width / 2;
                                background: @linear-gradient(135deg, Theme.accent.brighter(0.35) 0%, Theme.accent.darker(0.45) 100%);
                                border-width: ta-av.has-hover && !av.f ? (2px * S.k) : 0;
                                border-color: #ffffffb3;
                                Text { text: root.user-initial; font-size: (26px * S.k); font-weight: 600; color: #ffffff; }
                            }
                            ta-av := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, 6); } }
                        }
                        HorizontalLayout {
                            padding-left: (10px * S.k);
                            spacing: 0;
                        if root.battery-shown: bat := HorizontalLayout {
                            property <color> level: root.battery-plugged ? Theme.ok
                                : root.battery-percent <= 10 ? Theme.danger : root.battery-percent <= 20 ? Theme.warn : Theme.text;
                            padding-left: (12px * S.k);
                            padding-right: (12px * S.k);
                            spacing: (6px * S.k);
                            alignment: center;
                            // Upright, like a phone's: the cap on top, filled from the bottom.
                            Rectangle {
                                width: (16px * S.k);
                                height: (28px * S.k);
                                y: (parent.height - self.height) / 2;
                                Rectangle {
                                    x: (4.5px * S.k); y: 0;
                                    width: (5px * S.k); height: (3px * S.k);
                                    border-radius: (1px * S.k);
                                    background: bat.level.with-alpha(0.85);
                                }
                                Rectangle {
                                    y: (3px * S.k);
                                    height: parent.height - (3px * S.k);
                                    border-radius: (3px * S.k);
                                    border-width: (2px * S.k);
                                    border-color: bat.level.with-alpha(0.85);
                                    Rectangle {
                                        x: (3px * S.k);
                                        width: parent.width - (6px * S.k);
                                        height: max(2px * S.k, (parent.height - (6px * S.k)) * root.battery-percent / 100);
                                        y: parent.height - (3px * S.k) - self.height;
                                        border-radius: (1.5px * S.k);
                                        background: bat.level;
                                        animate height { duration: 400ms; }
                                    }
                                    // Charging: a white bolt inside, which shows on the fill and on the
                                    // empty part alike.
                                    if root.battery-plugged: Image {
                                        source: Icons.bolt;
                                        colorize: #ffffff;
                                        width: (11px * S.k);
                                        height: self.width;
                                    }
                                }
                            }
                            Text {
                                text: root.battery-percent + "%";
                                font-size: (22px * S.k); font-weight: 600;
                                color: bat.level == Theme.text ? Theme.text2 : bat.level;
                                vertical-alignment: center;
                            }
                        }
                            Text {
                                text: root.clock;
                                font-size: (26px * S.k); font-weight: 500;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                min-width: (110px * S.k);
                            }
                        }
                }
            }
        }

        // ------------------------------------------------------------ status + hints
        // Background work (downloads, updates): a small pill on the Home screen only, so it never
        // sits on top of Library titles or panels.
        if root.status != "" && root.view == 0 && root.overlay == 0: Rectangle {
            x: (76px * S.k);
            y: root.height - self.height - (30px * S.k) - (root.home-peek.length > 0 ? (96px * S.k) : 0) - root.home-lift;
            animate y { duration: 460ms; easing: ease-out-expo; }
            width: status-row.preferred-width;
            height: (50px * S.k);
            border-radius: (25px * S.k);
            background: #070a14e6;
            border-width: 1px;
            border-color: Theme.line;
            status-row := HorizontalLayout {
                padding-left: (18px * S.k);
                padding-right: (20px * S.k);
                spacing: (10px * S.k);
                if root.status-busy: Image {
                    source: Icons.spinner;
                    width: (18px * S.k);
                    height: (18px * S.k);
                    y: (16px * S.k);
                    transform-rotation: animation-tick() / 1ms * 0.4deg;
                }
                Text { text: root.status; font-size: (18px * S.k); color: Theme.text2; vertical-alignment: center; }
            }
        }
        Rectangle {
            x: root.width - self.width - (76px * S.k);
            // Over the Game Hub's cards on Home.
            y: root.height - self.height - (30px * S.k) - (root.view == 0 && root.overlay == 0 && root.home-peek.length > 0 ? (96px * S.k) + root.home-lift : 0);
            animate y { duration: 460ms; easing: ease-out-expo; }
            width: hints.preferred-width;
            height: (50px * S.k);
            border-radius: (25px * S.k);
            background: #070a14e6;
            border-width: 1px;
            border-color: Theme.line;
            // Hidden over the library grid so it never covers game titles, and under Settings and
            // the cards that ask something (Join Wi-Fi, Restart now?): they show their own keys.
            visible: root.overlay != 4 && root.overlay != 3 && root.overlay != 6 && root.overlay != 7 && root.overlay != 12 && root.overlay != 13 && root.overlay != 17
                && root.overlay != 2
                && (root.view == 0 || root.overlay != 0);
            hints := HorizontalLayout {
                padding-left: (20px * S.k);
                padding-right: (22px * S.k);
                spacing: (24px * S.k);
                alignment: center;
                // Only keys that do something on the current screen.
                for h in root.overlay == 0 && (!root.home-has-game || (root.view == 0 && root.home-welcome))
                    ? (root.pad-hints ? [{k: "✕", l: @tr("Select"), c: #8fb6ff, r: true}] : [{k: "Enter", l: @tr("Select"), c: #ffffff, r: false}])
                    : root.overlay == 0
                    ? (root.pad-hints
                        ? [{k: "✕", l: @tr("Select"), c: #8fb6ff, r: true}, {k: "□", l: @tr("Trailer"), c: #f5a3e6, r: true}, {k: "△", l: @tr("Search"), c: #6ee7c8, r: true}, {k: "☰", l: @tr("Options"), c: #ffffff, r: false}, {k: "Guide", l: @tr("Control Center"), c: #ffffff, r: false}]
                        : [{k: "Enter", l: @tr("Select"), c: #ffffff, r: false}, {k: "T", l: @tr("Trailer"), c: #ffffff, r: false}, {k: "/", l: @tr("Search"), c: #ffffff, r: false}, {k: "O", l: @tr("Options"), c: #ffffff, r: false}, {k: "F1", l: @tr("Control Center"), c: #ffffff, r: false}])
                    : root.overlay == 1
                    ? (root.pad-hints
                        ? [{k: "✕", l: @tr("Select"), c: #8fb6ff, r: true}, {k: "○", l: @tr("Back"), c: #ff8f9c, r: true}, {k: "□", l: @tr("Trailer"), c: #f5a3e6, r: true}, {k: "☰", l: @tr("Options"), c: #ffffff, r: false}]
                        : [{k: "Enter", l: @tr("Select"), c: #ffffff, r: false}, {k: "Esc", l: @tr("Back"), c: #ffffff, r: false}, {k: "T", l: @tr("Trailer"), c: #ffffff, r: false}, {k: "O", l: @tr("Options"), c: #ffffff, r: false}])
                    : (root.pad-hints
                        ? [{k: "✕", l: @tr("Select"), c: #8fb6ff, r: true}, {k: "○", l: @tr("Back"), c: #ff8f9c, r: true}]
                        : [{k: "Enter", l: @tr("Select"), c: #ffffff, r: false}, {k: "Esc", l: @tr("Back"), c: #ffffff, r: false}])
                    : HorizontalLayout {
                        spacing: (10px * S.k);
                        KeyCap { text: h.k; round: h.r; fg: h.c; y: (10px * S.k); }
                        Text { text: h.l; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    }
            }
        }

        // ------------------------------------------------------------ GAME HUB
        if root.overlay == 1 || root.hub-open: Rectangle {
            background: Theme.bg;
            property <bool> entered: false;
            init => { entered = true; }
            // In once it's at the section it opens on (no jump after), out the way it came.
            property <bool> shown: entered && root.hub-ready && !root.hub-leaving;
            opacity: shown ? 1 : 0;
            // From Home's cards it rises from below, as the page scrolling on.
            y: shown || !root.hub-scrolled ? 0 : root.height * 0.4;
            animate opacity { duration: root.hub-leaving ? 200ms : 300ms; easing: ease-out-quad; }
            animate y { duration: root.hub-leaving ? 260ms : 560ms; easing: ease-out-expo; }
            Image {
                source: root.bg-show-b ? root.bg-b : root.bg-a;
                width: root.width;
                height: root.height;
                image-fit: cover;
            }
            // The game's page, as a console's: its art behind, dimmed enough for text across the width.
            Rectangle { background: @linear-gradient(90deg, #04060ef2 0%, #04060ed9 45%, #04060ea6 75%, #04060e73 100%); }
            Rectangle { background: @linear-gradient(0deg, #04060ef0 0%, #04060e00 60%); }

            // Scroll areas crop their content, so they start `gutter` before the content: a selected
            // button's grow + glow must never be cut off at the edge.
            // The page scrolls from Rust (keys, wheel, touchpad) and glides there, as Home does.
            hub-flick := Rectangle {
                property <length> col-h: hub-col.height;
                property <length> content-height: hub-col.preferred-height + (200px * S.k);
                init => { root.hub-content-h = self.content-height; root.hub-col-h = self.col-h; }
                changed content-height => { root.hub-content-h = self.content-height; }
                changed col-h => { root.hub-col-h = self.col-h; }
                property <length> gutter: (40px * S.k);
                x: (96px * S.k) - self.gutter;
                width: root.width - (96px * S.k) - (60px * S.k) + self.gutter;
                height: root.height;
                TouchArea {
                    scroll-event(e) => {
                        root.hub-wheel(e.delta-y / 1px);
                        return EventResult.accept;
                    }
                }
                hub-col := VerticalLayout {
                    x: parent.gutter;
                    y: root.hub-y;
                    animate y { duration: root.hub-glide; easing: ease-out-quart; }
                    width: root.hub-text-w;
                    height: self.preferred-height;
                    padding-top: (130px * S.k);
                    spacing: 0;
                    if root.hub.kicker != "" || root.hub.kicker-accent != "": Kicker { text: root.hub.kicker; accent: root.hub.kicker-accent; live: root.hub.kicker-live; }
                    if root.hub.kicker != "" || root.hub.kicker-accent != "": Rectangle { height: (16px * S.k); }
                    if root.hub.has-logo: Image {
                        source: root.hub.logo;
                        width: root.hub.logo-w;
                        height: root.hub.logo-h;
                        image-fit: contain;
                    }
                    if !root.hub.has-logo: Text {
                        text: root.hub.title;
                        font-size: (72px * S.k);
                        font-weight: 700;
                        color: Theme.text;
                        width: root.hub-text-w;
                        wrap: word-wrap;
                    }
                    Rectangle { height: (22px * S.k); }
                    if root.hub.subtitle != "": Text { text: root.hub.subtitle; font-size: (20px * S.k); color: Theme.text2; wrap: word-wrap; }
                    if root.hub.subtitle != "" && root.hub.release-name != "": Rectangle { height: (8px * S.k); }
                    // What Download gets, when the title (a store's name) doesn't say it all.
                    if root.hub.release-name != "": Text { text: @tr("Release: {}", root.hub.release-name); font-size: (18px * S.k); color: Theme.text3; wrap: word-wrap; }
                    if root.hub.subtitle != "" || root.hub.release-name != "": Rectangle { height: (16px * S.k); }
                    HorizontalLayout {
                        spacing: (10px * S.k);
                        alignment: start;
                        for c in root.hub.chips: Chip { data: c; }
                    }
                    Rectangle { height: (26px * S.k); }
                    HorizontalLayout {
                        spacing: (16px * S.k);
                        alignment: start;
                        for a[i] in root.hub.actions: Btn {
                            data: a;
                            focused: root.zone == Zone.hub && root.idx == i && root.overlay == 1;
                            dim: root.zone == Zone.hub && root.idx != i && root.overlay == 1;
                            clicked => { root.click(Zone.hub, i); }
                        }
                    }
                    // What Download means: its size, where it goes and the next step.
                    if root.hub.download-note != "": HorizontalLayout {
                        padding-top: (14px * S.k);
                        padding-left: (8px * S.k);
                        spacing: (10px * S.k);
                        alignment: start;
                        if root.hub.download-note-warn: Image { source: Icons.alert; colorize: Theme.warn; width: (20px * S.k); height: (20px * S.k); y: (2px * S.k); }
                        // Wraps (two lines at most): what to do next is often at its end.
                        Text { text: root.hub.download-note; width: min((980px * S.k), root.hub-text-w - (40px * S.k)); wrap: word-wrap; max-height: (52px * S.k); overflow: elide; font-size: (19px * S.k); color: root.hub.download-note-warn ? Theme.warn : Theme.text2; }
                    }
                    Rectangle { height: (22px * S.k); }
                    // Compatibility
                    sec-compat := VerticalLayout {
                        padding-top: root.hub.verdict != "" ? (56px * S.k) : 0;
                        spacing: (18px * S.k);
                        if root.hub.verdict != "": Text { text: @tr("Compatibility"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                        if root.hub.verdict != "": Rectangle {
                            border-radius: (20px * S.k);
                            background: #0a0f1d8c;
                            border-width: 1px;
                            border-color: #ffffff1f;
                            VerticalLayout {
                                padding: (24px * S.k);
                                // Will it play here? One headline in the player's words, coloured honestly,
                                // with the results behind it in smaller text.
                                HorizontalLayout {
                                    spacing: (14px * S.k);
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: (11px * S.k);
                                        Rectangle {
                                            width: (14px * S.k); height: (14px * S.k); border-radius: (7px * S.k);
                                            background: root.hub.verdict-kind == 1 ? Theme.ok : root.hub.verdict-kind == 2 ? Theme.warn : root.hub.verdict-kind == 3 ? Theme.danger : Theme.text3;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: (4px * S.k);
                                        Text {
                                            text: root.hub.verdict; font-size: (28px * S.k); font-weight: 600;
                                            color: root.hub.verdict-kind == 1 ? Theme.ok : root.hub.verdict-kind == 2 ? Theme.warn : root.hub.verdict-kind == 3 ? Theme.danger : Theme.text;
                                        }
                                        if root.hub.verdict-detail != "": Text {
                                            width: root.hub-text-w - (110px * S.k);
                                            text: root.hub.verdict-detail; font-size: (17px * S.k); color: Theme.text3; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Versions
                    sec-versions := VerticalLayout {
                        init => { root.hub-at-versions = self.y; }
                        changed y => { root.hub-at-versions = self.y; }
                        padding-top: (root.hub.versions.length > 0 || root.hub.release-count > 1) ? (56px * S.k) : 0;
                        spacing: (18px * S.k);
                        if (root.hub.versions.length > 0 || root.hub.release-count > 1): Text { text: @tr("Versions"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                        // The game on each platform: how it should play here, how easy it is to get,
                        // and which to pick. Choosing one shows the game there.
                        if root.hub.versions.length > 0: VerticalLayout {
                            spacing: (12px * S.k);
                            padding-bottom: (18px * S.k);
                            HorizontalLayout {
                                spacing: (14px * S.k);
                                for v[i] in root.hub.versions: Rectangle {
                                    property <bool> f: root.zone == Zone.versions && root.idx == i && root.overlay == 1;
                                    horizontal-stretch: 1;
                                    height: (116px * S.k);
                                    border-radius: (16px * S.k);
                                    background: v.current ? #ffffff1c : #ffffff0d;
                                    border-width: f ? (3px * S.k) : v.current ? (2px * S.k) : 1px;
                                    border-color: f ? Theme.text : v.current ? Theme.accent : Theme.line;
                                    animate background, border-color { duration: 140ms; }
                                    VerticalLayout {
                                        padding: (16px * S.k);
                                        spacing: (5px * S.k);
                                        HorizontalLayout {
                                            spacing: (10px * S.k);
                                            Text {
                                                text: v.platform;
                                                font-size: (22px * S.k);
                                                font-weight: 800;
                                                letter-spacing: (0.5px * S.k);
                                                color: v.platform == "PS4" ? #b8d8ff : v.platform == "PC" ? #a8f0cc : #ffffff;
                                                vertical-alignment: center;
                                            }
                                            if v.best: Rectangle {
                                                width: best-text.preferred-width + (18px * S.k);
                                                height: (26px * S.k);
                                                y: (parent.height - self.height) / 2;
                                                border-radius: (13px * S.k);
                                                background: Theme.ok.with-alpha(0.18);
                                                border-width: 1px;
                                                border-color: Theme.ok.with-alpha(0.45);
                                                best-text := Text { text: @tr("Best for this PC"); font-size: (14px * S.k); font-weight: 700; color: Theme.ok; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if v.current: Text { text: @tr("Showing"); font-size: (14px * S.k); font-weight: 600; color: Theme.text3; vertical-alignment: center; }
                                        }
                                        Text {
                                            text: v.verdict;
                                            font-size: (18px * S.k);
                                            font-weight: 600;
                                            color: v.verdict-kind == 1 ? Theme.ok : v.verdict-kind == 2 ? Theme.warn : v.verdict-kind == 3 ? Theme.danger : Theme.text2;
                                            overflow: elide;
                                        }
                                        Text { text: v.detail; font-size: (16px * S.k); color: Theme.text3; overflow: elide; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.versions, i); } }
                                }
                            }
                            Text { text: @tr("Each version has its own saves and updates."); font-size: (15px * S.k); color: Theme.text3; }
                        }
                        // Other releases of this version (editions, regions, updates): big arrows, plain words.
                        if root.hub.release-count > 1: Rectangle {
                            height: (72px * S.k); border-radius: (14px * S.k); background: #ffffff0d;
                            border-width: root.zone == Zone.releases ? (3px * S.k) : 1px;
                            border-color: root.zone == Zone.releases ? Theme.text : Theme.line;
                            HorizontalLayout {
                                spacing: (16px * S.k); padding-left: (10px * S.k); padding-right: (10px * S.k);
                                Rectangle {
                                    width: (52px * S.k);
                                    Rectangle {
                                        width: (52px * S.k); height: (52px * S.k); border-radius: (26px * S.k);
                                        background: root.zone == Zone.releases ? #ffffff2e : #ffffff14;
                                        Image { source: Icons.chevl; colorize: Theme.text; width: (30px * S.k); height: (30px * S.k); }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.hub-release(-1); } }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: (2px * S.k); horizontal-stretch: 1;
                                    Text { text: root.hub.release-label; font-size: (20px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                                    if root.hub.release-detail != "": Text { text: root.hub.release-detail; font-size: (16px * S.k); color: Theme.text3; overflow: elide; }
                                }
                                Text { text: @tr("Choose another release"); font-size: (17px * S.k); color: root.zone == Zone.releases ? Theme.text : Theme.text2; vertical-alignment: center; }
                                Rectangle {
                                    width: (52px * S.k);
                                    Rectangle {
                                        width: (52px * S.k); height: (52px * S.k); border-radius: (26px * S.k);
                                        background: root.zone == Zone.releases ? #ffffff2e : #ffffff14;
                                        Image { source: Icons.chevr; colorize: Theme.text; width: (30px * S.k); height: (30px * S.k); }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.hub-release(1); } }
                                }
                            }
                        }
                    }
                    // Trailers & screenshots
                    sec-shots := VerticalLayout {
                        init => { root.hub-at-shots = self.y; }
                        changed y => { root.hub-at-shots = self.y; }
                        padding-top: root.hub.shots.length > 0 ? (56px * S.k) : 0;
                        spacing: (18px * S.k);
                        if root.hub.shots.length > 0: Text { text: @tr("Trailers & screenshots"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                        if root.hub.shots.length > 0: VerticalLayout {
                            padding-top: 0;
                            spacing: (14px * S.k);
                            Rectangle {
                            height: (262px * S.k);
                            Flickable {
                                // To the screen's edge, as a console's media rows (from a gutter
                                // before the column, so rings/glows aren't cut).
                                x: -(30px * S.k);
                                width: root.width - (96px * S.k) + (30px * S.k);
                                height: parent.height;
                                interactive: false;
                                content-x: root.shots-x;
                                animate content-x { duration: 340ms; easing: ease-out-quart; }
                                content-width: root.hub.shots.length * (424px * S.k) + (72px * S.k);
                                for s[i] in root.hub.shots: Rectangle {
                                    x: (30px * S.k) + i * (424px * S.k);
                                    y: (12px * S.k);
                                    width: (400px * S.k);
                                    height: (225px * S.k);
                                    FocusRing { w: parent.width; h: parent.height; on: root.zone == Zone.shots && root.idx == i && root.overlay == 1; radius: (16px * S.k); }
                                    Rectangle {
                                        border-radius: (16px * S.k);
                                        clip: true;
                                        background: Theme.panel;
                                        Shimmer { active: !s.loaded; }
                                        Image {
                                            source: s.image;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                            opacity: s.loaded ? 1 : 0;
                                            animate opacity { duration: 250ms; }
                                        }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.shots, i); } }
                                }
                            }
                            }
                        }
                    }
                    // Details
                    sec-details := VerticalLayout {
                        init => { root.hub-at-details = self.y; }
                        changed y => { root.hub-at-details = self.y; }
                        padding-top: true ? (56px * S.k) : 0;
                        spacing: (18px * S.k);
                        if true: Text { text: @tr("Details"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                        for fr in root.hub.facts: HorizontalLayout {
                            spacing: (14px * S.k);
                            padding-bottom: (14px * S.k);
                            for f in fr.items: Rectangle {
                                width: (root.hub-text-w - (28px * S.k)) / 3;
                                height: (92px * S.k);
                                border-radius: (16px * S.k);
                                background: #0b1020b8;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    padding-left: (22px * S.k);
                                    padding-right: (16px * S.k);
                                    alignment: center;
                                    spacing: (6px * S.k);
                                    Text { text: f.key; font-size: (15px * S.k); font-weight: 600; letter-spacing: (1.5px * S.k); color: Theme.text3; }
                                    Text { text: f.value; font-size: (21px * S.k); font-weight: 500; overflow: elide;
                                        color: f.kind == 1 ? Theme.ok : f.kind == 2 ? Theme.warn : f.kind == 3 ? Theme.danger : f.kind == 4 ? Theme.text3 : Theme.text; }
                                }
                            }
                        }
                        Rectangle {
                            height: (46px * S.k); border-radius: (10px * S.k);
                            background: root.zone == Zone.hub-details ? #ffffff1f : #ffffff08;
                            border-width: root.zone == Zone.hub-details ? (2px * S.k) : 1px;
                            border-color: root.zone == Zone.hub-details ? Theme.text : Theme.line;
                            Text { text: root.hub-details-open ? @tr("−  Hide technical details") : @tr("+  Technical details & installed game"); font-size: (18px * S.k); color: Theme.text2; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.hub-details, 0); } }
                        }
                        if root.hub-details-open: VerticalLayout {
                            padding-top: (16px * S.k); spacing: (10px * S.k);
                            for fr in root.hub.details: VerticalLayout {
                                spacing: (10px * S.k);
                                for f in fr.items: HorizontalLayout {
                                    spacing: (18px * S.k);
                                    Text { text: f.key; width: (280px * S.k); font-size: (17px * S.k); color: Theme.text3; }
                                    Text { text: f.value; font-size: (19px * S.k); color: Theme.text2; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    // About
                    sec-about := VerticalLayout {
                        init => { root.hub-at-about = self.y; }
                        changed y => { root.hub-at-about = self.y; }
                        padding-top: root.hub.about.length > 0 ? (56px * S.k) : 0;
                        spacing: (18px * S.k);
                        if root.hub.about.length > 0: Text { text: @tr("About"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                        if root.hub.about.length > 0: VerticalLayout {
                            spacing: (16px * S.k);
                            for p in root.hub.about: Text {
                                // Explicit width: wrapped text inside a nested block is otherwise measured
                                // unwrapped (one line), which made the page too short to scroll to the end.
                                width: min(root.hub-text-w, (1120px * S.k));
                                text: p;
                                font-size: (21px * S.k);
                                color: Theme.text2;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // The page scrolls under a dark band, so Back always reads.
        if root.overlay == 1: Rectangle {
            y: 0;
            height: (124px * S.k);
            background: @linear-gradient(180deg, #04060ef7 0%, #04060ed9 55%, #04060e00 100%);
            opacity: root.hub-y < -1px ? 1 : 0;
            animate opacity { duration: 180ms; }
        }
        if root.overlay == 1: BackButton {
            x: (96px * S.k);
            y: (44px * S.k);
            pad: root.pad-hints;
            clicked => { root.click(Zone.hub, -1); }
        }

        // ------------------------------------------------------------ SETTINGS
        // The whole screen, as a console's: first the sections as one list (Quit under them),
        // then a section's page (the sections on the left, its rows on the right). Also behind
        // the cards opened from it (Join Wi-Fi, Restart now?), so it's clear where they lead back.
        if root.overlay == 2 || root.overlay == 12 || root.overlay == 13: Rectangle {
            property <bool> entered: false;
            property <bool> in-rows: root.zone == Zone.settings;
            init => { entered = true; }
            // In with a slight zoom; out the same way when Back closes it.
            property <bool> on: entered && root.closing != 2;
            opacity: on ? 1 : 0;
            transform-scale: on ? 1 : 0.985;
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate transform-scale { duration: 420ms; easing: ease-out-expo; }
            // The theme's wallpaper (Deep blue for the game's art), dimmed for reading.
            Wallpaper { kind: root.wallpaper-kind == 0 ? 1 : root.wallpaper-kind; image: root.wallpaper-image; }
            Rectangle { background: @linear-gradient(180deg, #04060ecc 0%, #04060ee6 40%, #04060ef2 100%); }
            TouchArea {}

            // Title: "Settings" on the first page; on a section's page its name with a way back.
            // The two cross as the pages do.
            HorizontalLayout {
                x: (96px * S.k) - (root.settings-root ? 0 : (40px * S.k)); y: (40px * S.k);
                height: (64px * S.k);
                spacing: (18px * S.k);
                alignment: start;
                opacity: root.settings-root ? 1 : 0;
                visible: self.opacity > 0.01;
                animate opacity { duration: 220ms; easing: ease-out-quad; }
                animate x { duration: 420ms; easing: ease-out-expo; }
                Image { source: Icons.gear; colorize: Theme.text; width: (36px * S.k); height: self.width; y: (14px * S.k); }
                Text { text: @tr("Settings"); font-size: (36px * S.t); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }
            HorizontalLayout {
                x: (96px * S.k) + (root.settings-root ? (40px * S.k) : 0); y: (40px * S.k);
                height: (64px * S.k);
                spacing: (18px * S.k);
                alignment: start;
                opacity: root.settings-root ? 0 : 1;
                visible: self.opacity > 0.01;
                animate opacity { duration: 220ms; easing: ease-out-quad; }
                animate x { duration: 420ms; easing: ease-out-expo; }
                Rectangle {
                    width: (52px * S.k); height: self.width; y: (6px * S.k);
                    border-radius: self.width / 2;
                    background: ta-sback.has-hover ? #ffffff2e : #ffffff14;
                    Image { source: Icons.chevl; colorize: Theme.text; width: (26px * S.k); height: self.width; }
                    ta-sback := TouchArea { mouse-cursor: pointer; clicked => { root.settings-back(); } }
                }
                Text { text: root.settings-title; font-size: (36px * S.t); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }

            // ---- First page: the sections, one list.
            // Always there: it slides away to the left as a section's page comes in, and back.
            Rectangle {
                property <bool> came: false;
                init => { self.came = true; }
                property <bool> shown: self.came && root.settings-root;
                property <length> w: min((1080px * S.k), root.width - (192px * S.k));
                x: (root.width - self.w) / 2 - (root.settings-root ? 0 : (90px * S.k));
                y: (140px * S.k) + (self.came ? 0 : (24px * S.k));
                width: self.w;
                height: root.height - (140px * S.k) - (90px * S.k);
                opacity: self.shown ? 1 : 0;
                visible: self.opacity > 0.01;
                animate x { duration: 440ms; easing: ease-out-expo; }
                animate y { duration: 420ms; easing: ease-out-expo; }
                animate opacity { duration: 240ms; easing: ease-out-quad; }
                // One outline that glides to the row chosen (a section, or Quit under them).
                Rectangle {
                    property <int> n: root.settings-sections.length;
                    property <bool> foot: root.idx >= self.n;
                    x: 0;
                    width: parent.width;
                    y: self.foot ? self.n * (74px * S.k) + (22px * S.k) + (root.idx - self.n) * (64px * S.k) : max(0, root.idx) * (74px * S.k);
                    height: self.foot ? (64px * S.k) : (74px * S.k);
                    border-radius: (14px * S.k);
                    property <bool> danger: self.foot && root.settings-footer[root.idx - self.n].danger;
                    background: self.danger ? #ff5a6a33 : #ffffff1c;
                    border-width: (3px * S.k);
                    border-color: self.danger ? #ff8a9a : #f5f7fb;
                    opacity: root.zone == Zone.settings-nav && root.settings-root ? 1 : 0;
                    animate y, height { duration: 200ms; easing: ease-out-quart; }
                    animate background, border-color { duration: 160ms; }
                }
                VerticalLayout {
                    alignment: start;
                    spacing: 0;
                    for sec[i] in root.settings-sections: Rectangle {
                        property <bool> f: root.zone == Zone.settings-nav && root.idx == i;
                        height: (74px * S.k);
                        border-radius: (14px * S.k);
                        background: !f && ta-root.has-hover ? #ffffff0d : transparent;
                        animate background { duration: 120ms; }
                        // The list comes in one row after another.
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 260ms; delay: i * 28ms; easing: ease-out-quad; }
                        if !f: Rectangle { x: (20px * S.k); y: parent.height - 1px; width: parent.width - (40px * S.k); height: 1px; background: #ffffff14; }
                        HorizontalLayout {
                            padding-left: (26px * S.k); padding-right: (26px * S.k);
                            spacing: (22px * S.k);
                            Image { source: Icons.get(sec.icon); colorize: Theme.text; width: (30px * S.k); height: self.width; y: (22px * S.k); }
                            Text { text: sec.label; font-size: (23px * S.t); font-weight: 500; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if sec.note != "": Text {
                                text: sec.note; max-width: (260px * S.k); overflow: elide;
                                font-size: (17px * S.t); font-weight: 500;
                                color: sec.note-kind == 1 ? Theme.accent.brighter(0.4) : sec.note-kind == 2 ? Theme.warn : Theme.hint;
                                vertical-alignment: center;
                            }
                            Image { source: Icons.chevr; colorize: f ? Theme.text : #ffffff59; width: (20px * S.k); height: self.width; y: (27px * S.k); }
                        }
                        ta-root := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-nav, i); } }
                    }
                    Rectangle { height: (22px * S.k); }
                    // What Restart or Shut down just said (a game is still running, it failed).
                    for q in root.settings-footer: VerticalLayout {
                        padding-left: (26px * S.k); padding-right: (26px * S.k);
                        if q.hint != "": Text {
                            text: q.hint; font-size: (16px * S.t);
                            color: q.hint-kind == 1 ? Theme.ok : q.hint-kind == 2 ? Theme.danger : Theme.hint;
                            wrap: word-wrap; max-height: (60px * S.k); overflow: elide;
                        }
                    }
                    for q[k] in root.settings-footer: Rectangle {
                        property <bool> f: root.zone == Zone.settings-nav && root.idx == root.settings-sections.length + k;
                        height: (64px * S.k);
                        border-radius: (14px * S.k);
                        background: !f && ta-q.has-hover ? #ffffff0d : transparent;
                        HorizontalLayout {
                            padding-left: (26px * S.k); padding-right: (26px * S.k);
                            spacing: (22px * S.k);
                            Image { source: Icons.power; colorize: q.danger ? #ff8a9a : Theme.text2; width: (26px * S.k); height: self.width; y: (19px * S.k); }
                            Text { text: q.label; font-size: (21px * S.t); font-weight: 500; color: q.danger ? #ff8a9a : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if q.value != "" && !root.pad-hints: Text { text: q.value; font-size: (16px * S.t); color: Theme.text3; vertical-alignment: center; }
                        }
                        ta-q := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-nav, root.settings-sections.length + k); } }
                    }
                    Rectangle { height: (18px * S.k); }
                    Text { x: (26px * S.k); text: root.settings-version; font-size: (16px * S.t); color: Theme.hint; }
                }
            }

            // ---- A section's page: the sections on the left, its rows on the right.
            // Always there: a section's page slides in from the right as the first page goes.
            Rectangle {
                property <bool> shown: !root.settings-root;
                opacity: self.shown ? 1 : 0;
                visible: self.opacity > 0.01;
                x: self.shown ? 0 : (90px * S.k);
                animate opacity { duration: 260ms; easing: ease-out-quad; }
                animate x { duration: 440ms; easing: ease-out-expo; }
                // The sections' outline glides to the one chosen.
                Rectangle {
                    x: (96px * S.k) - (4px * S.k);
                    y: (140px * S.k) + max(0, min(root.idx, root.settings-sections.length - 1)) * (60px * S.k);
                    width: (360px * S.k); height: (56px * S.k);
                    border-radius: (12px * S.k);
                    background: #ffffff1c;
                    border-width: (3px * S.k);
                    border-color: #f5f7fb;
                    opacity: root.zone == Zone.settings-nav && !root.settings-root ? 1 : 0;
                    animate y { duration: 190ms; easing: ease-out-quart; }
                    animate opacity { duration: 140ms; }
                }
                VerticalLayout {
                    x: (96px * S.k) - (4px * S.k); y: (140px * S.k);
                    width: (360px * S.k);
                    height: self.preferred-height;
                    spacing: (4px * S.k);
                    for sec[i] in root.settings-sections: Rectangle {
                        property <bool> chosen: root.settings-section == i;
                        property <bool> f: root.zone == Zone.settings-nav && root.idx == i;
                        height: (56px * S.k);
                        border-radius: (12px * S.k);
                        background: !f && chosen ? #ffffff12 : !f && ta-sec.has-hover ? #ffffff0a : transparent;
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            padding-left: (18px * S.k); padding-right: (14px * S.k);
                            spacing: (14px * S.k);
                            Rectangle {
                                width: (4px * S.k); height: (24px * S.k); y: (16px * S.k);
                                border-radius: (2px * S.k);
                                background: sec.note-kind == 2 ? Theme.warn : chosen ? Theme.accent : transparent;
                            }
                            Text {
                                text: sec.label; font-size: (20px * S.t); font-weight: chosen ? 600 : 400;
                                color: chosen || f ? Theme.text : Theme.text2;
                                vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                            }
                        }
                        ta-sec := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-nav, i); } }
                    }
                }
                // The rows: under a line saying what the section is for.
                Rectangle {
                    x: (96px * S.k) + (360px * S.k) + (64px * S.k);
                    y: (140px * S.k);
                    width: root.width - self.x - (96px * S.k);
                    height: root.height - self.y - (90px * S.k);
                    Text { x: 0; y: (8px * S.k); text: root.settings-sub; font-size: (19px * S.t); color: Theme.hint; }
                    rows := Flickable {
                        // 4 px of room each side for the focus ring.
                        x: -(4px * S.k); y: (64px * S.k);
                        width: parent.width + (8px * S.k);
                        height: parent.height - self.y;
                        content-y <=> root.settings-y;
                        // Room for the focus ring around the first and last rows.
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            x: 0; y: 0;
                            width: parent.width; height: self.preferred-height;
                            padding: (4px * S.k);
                            spacing: 0;
                            // Every row is here; only the chosen section's take room (spacing
                            // between hidden ones would leave gaps, so each shown row has its own).
                            for s[i] in root.settings: VerticalLayout {
                                property <bool> shown: s.kind != 0 && s.section == root.settings-section;
                                property <bool> f: root.zone == Zone.settings && root.idx == i;
                                visible: shown;
                                padding-bottom: shown ? (4px * S.k) : 0;
                                height: shown ? self.preferred-height : 0;
                                if shown && s.kind < 5: row := Rectangle {
                                    property <bool> editing: s.kind == 1 && root.edit-index == i;
                                    // What's on the right (a switch, a value, a choice, at least a
                                    // chevron), centred on the row; the words wrap beside it.
                                    property <bool> has-right: !editing;
                                    height: max((80px * S.k), words.preferred-height);
                                    // A plain line in a list, as a console's: the one chosen is outlined.
                                    border-radius: (14px * S.k);
                                    background: f ? (s.danger ? #ff5a6a33 : #ffffff1c) : ta-row.has-hover ? #ffffff0d : transparent;
                                    // Always outlined, in a colour that fades in: no snap from row to row.
                                    border-width: (3px * S.k);
                                    border-color: !f ? #f5f7fb00 : s.danger ? Theme.danger : #f5f7fb;
                                    animate background, border-color { duration: 170ms; easing: ease-out-quad; }
                                    if !f: Rectangle { x: (20px * S.k); y: parent.height - 1px; width: parent.width - (40px * S.k); height: 1px; background: #ffffff14; }
                                    ta-row := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings, i); } }
                                    words := VerticalLayout {
                                        x: 0; y: 0; width: parent.width; height: parent.height;
                                        padding-left: (24px * S.k);
                                        padding-right: (24px * S.k) + (row.has-right ? aside.width + (20px * S.k) : 0);
                                        padding-top: (16px * S.k); padding-bottom: (16px * S.k);
                                        spacing: (5px * S.k);
                                        alignment: center;
                                        Text {
                                            text: s.label;
                                            font-size: (21px * S.t); font-weight: 500;
                                            color: s.danger ? #ffb3bb : Theme.text;
                                            overflow: elide;
                                        }
                                        if s.hint != "": Text {
                                            text: s.hint;
                                            font-size: (17px * S.t);
                                            wrap: word-wrap;
                                            color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : #9ba6c0;
                                        }
                                        if row.editing: Rectangle {
                                            height: (52px * S.t);
                                            border-radius: (12px * S.k);
                                            background: #00000052;
                                            border-width: 1px;
                                            border-color: #ffffff29;
                                            TextInput {
                                                x: (14px * S.k);
                                                width: parent.width - (28px * S.k);
                                                height: parent.height;
                                                text <=> root.edit-text;
                                                single-line: true;
                                                input-type: s.secret ? InputType.password : InputType.text;
                                                font-size: (18px * S.t);
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                font-family: "DejaVu Sans Mono";
                                                init => { self.focus(); self.select-all(); }
                                                accepted => { root.edit-done(self.text, true); }
                                            }
                                        }
                                    }
                                    aside := HorizontalLayout {
                                        visible: row.has-right;
                                        // A long value (a folder) never takes more than about half the row.
                                        width: min(self.preferred-width, parent.width * 0.45);
                                        height: self.preferred-height;
                                        x: parent.width - self.width - (24px * S.k);
                                        y: (parent.height - self.height) / 2;
                                        spacing: (10px * S.k);
                                        alignment: end;
                                        if s.kind == 2: Switch { on: s.on; }
                                        // A level (Volume): the bar, then the ‹ value ›.
                                        if s.has-bar: Rectangle {
                                            width: (240px * S.k); height: (8px * S.k);
                                            y: (parent.height - self.height) / 2;
                                            border-radius: (4px * S.k);
                                            background: #ffffff1f;
                                            Rectangle {
                                                x: 0; width: parent.width * clamp(s.bar, 0, 1); height: parent.height;
                                                border-radius: parent.border-radius;
                                                background: Theme.accent.brighter(0.2);
                                                animate width { duration: 160ms; easing: ease-out-quad; }
                                            }
                                        }
                                        if s.kind == 3: Image { y: (parent.height - self.height) / 2; source: Icons.chevl; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); }
                                        if s.kind == 3: Text { text: s.value; font-size: (19px * S.t); color: Theme.text; vertical-alignment: center; }
                                        if s.kind == 3: Image { y: (parent.height - self.height) / 2; source: Icons.chevr; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); }
                                        if (s.kind == 1 || s.kind == 4) && s.busy: Image {
                                            y: (parent.height - self.height) / 2;
                                            source: Icons.spinner;
                                            width: (20px * S.k); height: self.width;
                                            transform-rotation: animation-tick() / 1ms * 0.4deg;
                                        }
                                        if (s.kind == 1 || s.kind == 4) && s.icon != "": Image {
                                            y: (parent.height - self.height) / 2;
                                            source: Icons.get(s.icon);
                                            colorize: s.value-kind == 1 ? Theme.ok : s.value-kind == 2 ? Theme.danger : Theme.text2;
                                            width: (20px * S.k); height: self.width;
                                        }
                                        if s.kind == 1 || (s.kind == 4 && s.value != ""): Text {
                                            text: s.kind == 1 && s.value == "" ? (s.secret ? @tr("Not set") : "—") : s.value;
                                            font-size: (19px * S.t);
                                            font-family: s.kind == 1 ? "DejaVu Sans Mono" : "";
                                            font-weight: s.value-kind == 3 ? 600 : 400;
                                            color: s.value-kind == 1 ? #3ddc97 : s.value-kind == 2 ? Theme.danger : s.value-kind == 3 ? #7ab4ff : #dfe4ef;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            min-width: (40px * S.k);
                                        }
                                        // A Wi-Fi network: a lock when it needs a password, then its bars.
                                        if s.kind == 4 && s.signal > 0: Rectangle {
                                            width: (22px * S.k);
                                            if s.lock: Image { source: Icons.lock; colorize: Theme.text2; width: (18px * S.k); height: self.width; }
                                        }
                                        if s.kind == 4 && s.signal > 0: Image {
                                            y: (parent.height - self.height) / 2;
                                            source: Icons.signal[s.signal - 1];
                                            colorize: s.signal >= 3 ? Theme.text : s.signal == 2 ? Theme.text2 : Theme.warn;
                                            width: (24px * S.k); height: self.width;
                                        }
                                        if s.kind == 1 || s.kind == 4: Image { y: (parent.height - self.height) / 2; source: Icons.chevr; colorize: #9ba6c0; width: (18px * S.k); height: self.width; }
                                    }
                                }
                                // A drive, as a console's storage screen: its name and size, a bar in
                                // parts (games, downloads, media, other), its free space.
                                if shown && s.kind == 5: Rectangle {
                                    height: drive-v.preferred-height;
                                    border-radius: (14px * S.k);
                                    background: f ? #ffffff1c : ta-drive.has-hover ? #ffffff0d : transparent;
                                    border-width: (3px * S.k);
                                    border-color: f ? #f5f7fb : #f5f7fb00;
                                    animate background, border-color { duration: 170ms; easing: ease-out-quad; }
                                    ta-drive := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings, i); } }
                                    drive-v := VerticalLayout {
                                        padding-left: (24px * S.k); padding-right: (24px * S.k);
                                        padding-top: (20px * S.k); padding-bottom: (18px * S.k);
                                        spacing: (12px * S.k);
                                        HorizontalLayout {
                                            spacing: (16px * S.k);
                                            Text { text: s.label; font-size: (22px * S.t); font-weight: 600; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: s.value; font-size: (17px * S.t); color: s.value-kind == 2 && s.segs.length == 0 ? Theme.danger : #dfe4ef; vertical-alignment: center; }
                                        }
                                        bar-bg := Rectangle {
                                            height: (10px * S.k);
                                            border-radius: (5px * S.k);
                                            background: #ffffff1a;
                                            clip: true;
                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: 0;
                                                for v[k] in s.segs: Rectangle {
                                                    width: bar-bg.width * clamp(v, 0, 1);
                                                    background: StorageColors.parts[k];
                                                    animate width { duration: 520ms; easing: ease-out-quart; }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: (16px * S.k);
                                            Text { text: s.hint; font-size: (16px * S.t); color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : #9ba6c0; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: s.value2; font-size: (16px * S.t); color: s.value-kind == 2 ? Theme.danger : #9ba6c0; }
                                        }
                                    }
                                }
                                // A line of its legend: the colour, what it is, how much.
                                if shown && s.kind == 6: Rectangle {
                                    height: max((62px * S.k), part-v.preferred-height);
                                    border-radius: (14px * S.k);
                                    background: f ? #ffffff1c : ta-part.has-hover ? #ffffff0d : transparent;
                                    border-width: (3px * S.k);
                                    border-color: f ? #f5f7fb : #f5f7fb00;
                                    animate background, border-color { duration: 170ms; easing: ease-out-quad; }
                                    if !f: Rectangle { x: (64px * S.k); y: parent.height - 1px; width: parent.width - (84px * S.k); height: 1px; background: #ffffff10; }
                                    ta-part := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings, i); } }
                                    HorizontalLayout {
                                        padding-left: (28px * S.k); padding-right: (24px * S.k);
                                        spacing: (18px * S.k);
                                        Rectangle {
                                            width: (18px * S.k); height: self.width;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: self.width / 2;
                                            background: StorageColors.parts[max(0, s.dot - 1)];
                                        }
                                        part-v := VerticalLayout {
                                            alignment: center;
                                            padding-top: (10px * S.k); padding-bottom: (10px * S.k);
                                            spacing: (3px * S.k);
                                            horizontal-stretch: 1;
                                            Text { text: s.label; font-size: (19px * S.t); color: Theme.text; overflow: elide; }
                                            if s.hint != "": Text { text: s.hint; font-size: (15px * S.t); wrap: word-wrap; color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : #9ba6c0; }
                                        }
                                        Text { text: s.value; font-size: (17px * S.t); color: #9ba6c0; vertical-alignment: center; }
                                    }
                                }
                            }
                            // About: required attribution for the Slint royalty-free license (section 2a).
                            if root.settings-section == root.settings-sections.length - 1: Rectangle {
                                border-radius: (18px * S.k);
                                background: #ffffff0f;
                                border-width: 1px; border-color: #ffffff14;
                                HorizontalLayout {
                                    padding: (24px * S.k);
                                    spacing: (20px * S.k);
                                    VerticalLayout { alignment: center; Image { source: Icons.app; width: (72px * S.k); height: (72px * S.k); } }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: (5px * S.k);
                                        horizontal-stretch: 1;
                                        Text { text: "SwarmPlay"; font-size: (21px * S.t); font-weight: 600; color: Theme.text; }
                                        Text { text: @tr("Version {} · Linux", root.app-version); font-size: (17px * S.t); color: #9ba6c0; }
                                        Text { text: @tr("PS5 games on KytyPS5 · PS4 games on shadPS4"); font-size: (17px * S.t); color: #9ba6c0; }
                                    }
                                    VerticalLayout { alignment: center; AboutSlint { width: (200px * S.k); } }
                                }
                            }
                        }
                    }
                }
            }

            // What the buttons do here.
            set-hints := HorizontalLayout {
                // Not behind the cards opened from it (Join Wi-Fi, Restart now?): they show
                // their own keys.
                visible: root.overlay == 2;
                x: (96px * S.k); width: root.width - (192px * S.k);
                height: (26px * S.t); y: root.height - (44px * S.k) - self.height;
                alignment: end;
                spacing: (22px * S.k);
                // Back/Close can be clicked too: from the rows to the sections, else closed.
                // About has no rows to open: only Close there.
                // What Enter does: open a section, change a row, or (on Quit, Restart…) that.
                for h in (root.zone == Zone.settings-nav && (root.settings-root || root.idx >= root.settings-sections.length)) ? [
                    { glyph: root.pad-hints ? "✕" : "Enter", label: @tr("Select"), tint: #8dbaff, back: false },
                    { glyph: root.pad-hints ? "○" : "Esc", label: @tr("Close"), tint: #ff8a9a, back: true },
                ] : (!in-rows && root.settings-section == root.settings-sections.length - 1) ? [
                    { glyph: root.pad-hints ? "○" : "Esc", label: @tr("Back"), tint: #ff8a9a, back: true },
                ] : (in-rows && root.settings[root.idx].removable) ? [
                    { glyph: root.pad-hints ? "✕" : "Enter", label: @tr("Select"), tint: #8dbaff, back: false },
                    { glyph: root.pad-hints ? "□" : "T", label: @tr("Remove"), tint: #f5a9e0, back: false },
                    { glyph: root.pad-hints ? "○" : "Esc", label: @tr("Back"), tint: #ff8a9a, back: true },
                ] : [
                    { glyph: root.pad-hints ? "✕" : "Enter", label: !in-rows ? @tr("Open") : root.settings[root.idx].kind >= 4 ? @tr("Select") : @tr("Change"), tint: #8dbaff, back: false },
                    { glyph: root.pad-hints ? "○" : "Esc", label: root.settings-root ? @tr("Close") : @tr("Back"), tint: #ff8a9a, back: true },
                ]: Rectangle {
                    width: hint-row.preferred-width;
                    hint-row := HorizontalLayout {
                        spacing: (8px * S.k);
                        Rectangle {
                            width: root.pad-hints ? (26px * S.k) : kc.preferred-width + (14px * S.k);
                            height: (26px * S.k);
                            border-radius: (13px * S.k);
                            background: #ffffff24;
                            kc := Text { text: h.glyph; font-size: root.pad-hints ? (13px * S.k) : (12px * S.k); color: root.pad-hints ? h.tint : #dfe4ef; font-weight: 600; }
                        }
                        Text { text: h.label; font-size: (16px * S.t); color: #dfe4ef; vertical-alignment: center; }
                    }
                    if h.back: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.settings-back(); }
                    }
                }
            }
        }

        // ------------------------------------------------------------ BACKGROUND DOWNLOADS
        if root.overlay == 8: LibrarySortPicker {
            options: root.sort-options; selected: root.idx; current: root.sort-selected;
            type-scale: root.library-type-scale; anchor-x: root.library-sort-anchor;
            choose(index) => { root.click(Zone.sort-picker, index); }
            close => { root.click(Zone.sort-picker, -1); }
        }
        if root.overlay == 7 && !root.download-consent: DownloadsPage {
            property <bool> entered: false;
            init => { self.entered = true; }
            opacity: self.entered && root.closing != 7 ? 1 : 0;
            y: self.entered && root.closing != 7 ? 0 : (28px * S.k);
            animate opacity { duration: 240ms; easing: ease-out-quad; }
            animate y { duration: 420ms; easing: ease-out-expo; }
            data: root.downloads; sel: root.download-sel; focus-btn: root.download-focus-btn; pad: root.pad-hints;
            tabs: root.download-tabs; filter: root.download-filter; shelf-x: root.download-shelf-x;
            down: root.download-down; up: root.download-up; vpn: root.download-vpn; vpn-kind: root.download-vpn-kind;
            has-any: root.download-has-any; empty-title: root.download-empty-title; note: root.download-page-note;
            glass: root.download-glass; has-glass: root.download-has-glass;
            delete-open: root.download-delete-open; delete-title: root.download-delete-title;
            delete-choices: root.download-delete-choices; delete-sel: root.download-delete-sel;
            delete-choose(i) => { root.download-delete-choose(i); }
            delete-close => { root.download-delete-choose(-1); }
            action(key, action) => { root.download-action(key, action); }
            select(i) => { root.download-select(i); }
            filter-clicked(i) => { root.download-filter-clicked(i); }
            close => { root.download-close(); }
        }
        if root.overlay == 15: DownloadPanel {
            title: root.setup-title; vpn: root.setup-vpn; vpn-ok: root.setup-vpn-ok; pad: root.pad-hints;
            glass: root.setup-glass; has-glass: root.setup-has-glass;
            state: root.setup-state; message-title: root.setup-message-title; message: root.setup-message;
            files: root.setup-files; count: root.setup-count; total: root.setup-total; all-state: root.setup-all-state;
            notice: root.setup-notice; notice-kind: root.setup-notice-kind;
            dl-path <=> root.setup-dl-path; inst-path <=> root.setup-inst-path;
            dl-line: root.setup-dl-line; dl-frac: root.setup-dl-frac; dl-bad: root.setup-dl-bad;
            inst-line: root.setup-inst-line; inst-frac: root.setup-inst-frac; inst-bad: root.setup-inst-bad;
            go-label: root.setup-go-label; go-enabled: root.setup-go-enabled;
            focus-row: root.setup-focus-row; focus-item: root.setup-focus-item; edit: root.setup-edit;
            toggle(i) => { root.setup-toggle(i); }
            go => { root.setup-go(); }
            cancel => { root.setup-cancel(); }
            change(i) => { root.setup-change(i); }
            edited(focused) => { root.setup-editing = focused; }
            // Leaving the field any way (a click elsewhere too) finishes editing it.
            left(i) => { root.setup-edit-left(i); }
            edit-done => { root.setup-edit-done(); root.focus-root(); }
        }
        if root.overlay == 7 && root.download-consent: DownloadConsent {
            focus-path: root.download-focus-path;
            install: root.download-is-install;
            title: root.download-title; error: root.download-error; privacy: root.download-privacy; install-note: root.download-install-note; warning: root.download-warning;
            destination <=> root.download-path;
            confirm => { root.download-confirm(); }
            close => { root.download-close(); }
            edit-done => { root.focus-root(); }
            editing(focused) => { root.download-editing = focused; root.download-focus-path = false; }
        }

        // ------------------------------------------------------------ SCREENSHOT VIEWER
        // A gallery, as a console's: the picture full screen, the others in a strip under it
        // (the one shown outlined), arrows at the sides for the mouse.
        if root.overlay == 3: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            // Out the way it came in when Back closes it.
            property <bool> on: entered && root.closing != 3;
            opacity: on ? 1 : 0;
            animate opacity { duration: 200ms; easing: ease-out-quad; }
            background: #000000;
            TouchArea { clicked => { root.click(Zone.shots, -1); } }
            Image {
                width: root.width;
                height: root.height;
                source: root.viewer-image;
                image-fit: contain;
                transform-scale: on ? 1 : 1.03;
                animate transform-scale { duration: 420ms; easing: ease-out-expo; }
            }
            Rectangle { height: (150px * S.k); y: 0; background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%); }
            Rectangle { height: (230px * S.k); y: root.height - self.height; background: @linear-gradient(0deg, #000000d9 0%, #00000000 100%); }
            BackButton {
                x: (48px * S.k);
                y: (36px * S.k);
                pad: root.pad-hints;
                clicked => { root.click(Zone.shots, -1); }
            }
            Text {
                x: root.width - self.width - (56px * S.k); y: (46px * S.k);
                text: root.viewer-count; font-size: (19px * S.k); font-weight: 500; color: Theme.text2;
            }
            // Arrows at the sides.
            for d[k] in [-1, 1]: Rectangle {
                x: d < 0 ? (40px * S.k) : root.width - self.width - (40px * S.k);
                y: (root.height - self.height) / 2;
                width: (64px * S.k); height: self.width;
                border-radius: self.width / 2;
                background: ta-arrow.has-hover ? #ffffff33 : #00000066;
                border-width: 1px; border-color: #ffffff26;
                animate background { duration: 120ms; }
                Image { source: d < 0 ? Icons.chevl : Icons.chevr; colorize: Theme.text; width: (32px * S.k); height: self.width; }
                ta-arrow := TouchArea { mouse-cursor: pointer; clicked => { root.viewer-step(d); } }
            }
            // The strip: every screenshot, the one shown centred and outlined.
            strip := Rectangle {
                property <length> tw: (176px * S.k);
                property <length> th: (99px * S.k);
                property <length> gap: (14px * S.k);
                y: root.height - self.th - (40px * S.k);
                height: self.th + (8px * S.k);
                clip: false;
                Rectangle {
                    x: root.width / 2 - strip.tw / 2 - root.viewer-index * (strip.tw + strip.gap);
                    animate x { duration: 320ms; easing: ease-out-quart; }
                    for s[i] in root.hub.shots: Rectangle {
                        property <bool> cur: i == root.viewer-index;
                        x: i * (strip.tw + strip.gap);
                        y: (4px * S.k);
                        width: strip.tw;
                        height: strip.th;
                        opacity: cur ? 1 : 0.55;
                        animate opacity { duration: 200ms; }
                        FocusRing { w: parent.width; h: parent.height; on: parent.cur; radius: (10px * S.k); glow: false; }
                        Rectangle {
                            border-radius: (10px * S.k);
                            clip: true;
                            background: Theme.panel;
                            Image { source: s.image; width: parent.width; height: parent.height; image-fit: cover; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.viewer-step(i - root.viewer-index); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ OPTIONS MENU
        // A narrow card of words, as a console's: from Home's ··· it rises beside the button;
        // elsewhere it sits in the middle.
        if root.overlay == 5: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            // Out the way it came in when Back closes it.
            property <bool> on: entered && root.closing != 5;
            background: on ? #03050c66 : #03050c00;
            animate background { duration: 200ms; }
            TouchArea { clicked => { root.click(Zone.menu, -1); } }
            menu-card := Rectangle {
                property <bool> anchored: root.menu-anchor == 1;
                width: (440px * S.k);
                height: menu-col.preferred-height;
                x: anchored ? (440px * S.k) : root.menu-anchor == 2 ? root.width - self.width - (96px * S.k) : (root.width - self.width) / 2;
                // Its bottom level with the hero's buttons (see HeroView's place on Home); Power's
                // by the bottom corner, where the Control Center's Power was.
                y: (anchored ? max((110px * S.k), root.height - (196px * S.k) - self.height)
                    : root.menu-anchor == 2 ? root.height - self.height - (72px * S.k)
                    : (root.height - self.height) / 2) + (on ? 0 : (16px * S.k));
                opacity: on ? 1 : 0;
                animate opacity { duration: 180ms; easing: ease-out-quad; }
                animate y { duration: 300ms; easing: ease-out-expo; }
                border-radius: (18px * S.k);
                background: #1a1e2bfa;
                border-width: 1px;
                border-color: #ffffff1f;
                drop-shadow-blur: (40px * S.k);
                drop-shadow-color: #00000099;
                TouchArea {}
                // One highlight that glides to the item chosen (under the words).
                Rectangle {
                    x: (12px * S.k);
                    width: parent.width - (24px * S.k);
                    height: (54px * S.k);
                    y: (12px * S.k) + (42px * S.k) + max(0, root.idx) * (56px * S.k);
                    border-radius: (10px * S.k);
                    background: #f5f7fb;
                    opacity: root.zone == Zone.menu ? 1 : 0;
                    animate y { duration: 190ms; easing: ease-out-quart; }
                }
                menu-col := VerticalLayout {
                    padding: (12px * S.k);
                    spacing: (2px * S.k);
                    HorizontalLayout {
                        padding-left: (16px * S.k); padding-right: (16px * S.k);
                        height: (40px * S.k);
                        Text { text: root.menu-title; font-size: (16px * S.k); font-weight: 500; color: Theme.hint; overflow: elide; vertical-alignment: center; }
                    }
                    for m[i] in root.menu-items: Rectangle {
                        height: (54px * S.k);
                        border-radius: (10px * S.k);
                        property <bool> f: root.zone == Zone.menu && root.idx == i;
                        background: !f && ta-m.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 100ms; }
                        // They come in one after another.
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 220ms; delay: i * 22ms; easing: ease-out-quad; }
                        // Long labels (a game's file names) stay inside the menu.
                        Text {
                            x: (16px * S.k) + (parent.shown ? 0 : (14px * S.k)); width: parent.width - (32px * S.k);
                            text: m.label; font-size: (20px * S.k);
                            color: f ? #0a0d18 : Theme.text;
                            animate color { duration: 150ms; }
                            animate x { duration: 300ms; delay: i * 22ms; easing: ease-out-expo; }
                            vertical-alignment: center; overflow: elide;
                        }
                        ta-m := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.menu, i); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ CONTROL CENTER
        // Guide's panel (src/control_center.rs). Items in focus order: [Back to game, Close game]
        // when a game runs, Downloads, then Library, Settings, Controls, Power.
        if root.overlay == 16: Rectangle {
            property <bool> entered: false;
            property <int> o: root.running.active ? 2 : 0;
            init => { entered = true; }
            // Out the way it came in when Back closes it.
            property <bool> on: entered && root.closing != 16;
            background: on ? #03050cb3 : #03050c00;
            animate background { duration: 200ms; }
            TouchArea { clicked => { root.click(Zone.control-center, -1); } }
            cc-panel := Rectangle {
                height: (400px * S.k);
                y: on ? root.height - self.height : root.height;
                animate y { duration: 320ms; easing: ease-out-expo; }
                background: #101628f5;
                border-width: 1px;
                border-color: Theme.line;
                TouchArea {}
                // Top row: the running game, then the downloads.
                HorizontalLayout {
                    x: (96px * S.k);
                    y: (36px * S.k);
                    height: (170px * S.k);
                    spacing: (20px * S.k);
                    alignment: start;
                    if root.running.active: Rectangle {
                        width: (560px * S.k);
                        border-radius: (20px * S.k);
                        background: #1c2440;
                        VerticalLayout {
                            padding: (22px * S.k);
                            spacing: (6px * S.k);
                            Text { text: @tr("NOW PLAYING · {}", root.running.time); font-size: (15px * S.k); font-weight: 600; letter-spacing: (1.5px * S.k); color: Theme.text2; }
                            Text { text: root.running.name; font-size: (26px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                spacing: (12px * S.k);
                                alignment: start;
                                for b[i] in [{ label: @tr("Back to game"), danger: false }, { label: @tr("Close game"), danger: true }]: Rectangle {
                                    property <bool> f: root.zone == Zone.control-center && root.idx == i;
                                    width: cc-btn-label.preferred-width + (40px * S.k);
                                    height: (48px * S.k);
                                    border-radius: self.height / 2;
                                    background: f ? (b.danger ? Theme.danger : #ffffff) : b.danger ? #ff5a6a2e : #ffffff24;
                                    drop-shadow-blur: f ? (24px * S.k) : 0;
                                    drop-shadow-color: Theme.glow;
                                    animate background { duration: Theme.fast; }
                                    cc-btn-label := Text { text: b.label; font-size: (19px * S.k); font-weight: 600; color: f && !b.danger ? #0a0d18 : #ffffff; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.control-center, i); } }
                                }
                            }
                        }
                    }
                    dl-card := Rectangle {
                        property <bool> f: root.zone == Zone.control-center && root.idx == o;
                        width: (480px * S.k);
                        FocusRing { w: parent.width; h: parent.height; on: dl-card.f; radius: (20px * S.k); }
                        // Over the ring, as cover art is elsewhere: the ring's halo fills its shape.
                        Rectangle { border-radius: (20px * S.k); background: #1c2440; }
                        VerticalLayout {
                            padding: (22px * S.k);
                            spacing: (8px * S.k);
                            Text { text: @tr("DOWNLOADS"); font-size: (15px * S.k); font-weight: 600; letter-spacing: (1.5px * S.k); color: Theme.text2; }
                            Text {
                                text: root.ring-kind > 0 ? root.ring-label + root.ring-suffix : @tr("Nothing downloading");
                                font-size: (24px * S.k);
                                font-weight: 600;
                                color: root.ring-kind == 3 ? Theme.warn : root.ring-kind == 5 ? Theme.ok : Theme.text;
                                overflow: elide;
                            }
                            Rectangle { vertical-stretch: 1; }
                            Text { text: @tr("Open Downloads"); font-size: (17px * S.k); color: Theme.hint; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.control-center, o); } }
                    }
                    // Notifications: how many are new, the newest; opens the list.
                    nt-card := Rectangle {
                        property <bool> f: root.zone == Zone.control-center && root.idx == o + 1;
                        width: (400px * S.k);
                        FocusRing { w: parent.width; h: parent.height; on: nt-card.f; radius: (20px * S.k); }
                        Rectangle { border-radius: (20px * S.k); background: #1c2440; }
                        VerticalLayout {
                            padding: (22px * S.k);
                            spacing: (8px * S.k);
                            HorizontalLayout {
                                spacing: (10px * S.k);
                                alignment: start;
                                Text { text: @tr("NOTIFICATIONS"); font-size: (15px * S.k); font-weight: 600; letter-spacing: (1.5px * S.k); color: Theme.text2; }
                                if root.notif-count > 0: Rectangle {
                                    width: max(self.height, nc.preferred-width + (14px * S.k)); height: (22px * S.k);
                                    border-radius: self.height / 2;
                                    background: Theme.accent;
                                    nc := Text { text: root.notif-count; font-size: (13px * S.k); font-weight: 700; color: #ffffff; }
                                }
                            }
                            Text { text: root.notif-last; font-size: (22px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                            Rectangle { vertical-stretch: 1; }
                            Text { text: @tr("Open notifications"); font-size: (17px * S.k); color: Theme.hint; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.control-center, o + 1); } }
                    }
                }
                // Bottom row: quick ways around.
                HorizontalLayout {
                    x: (96px * S.k);
                    y: (232px * S.k);
                    height: (128px * S.k);
                    spacing: (18px * S.k);
                    alignment: start;
                    for t[i] in [{ label: @tr("Library"), icon: "grid" }, { label: @tr("Settings"), icon: "gear" }, { label: @tr("Controls"), icon: "info" },
                                 { label: root.on-os ? @tr("Power") : @tr("Quit"), icon: "power" }]: Rectangle {
                        property <bool> f: root.zone == Zone.control-center && root.idx == o + 2 + i;
                        width: (128px * S.k);
                        border-radius: (20px * S.k);
                        background: f ? #ffffff : #ffffff14;
                        transform-scale: f ? 1.05 : 1.0;
                        animate background { duration: Theme.fast; }
                        animate transform-scale { duration: 220ms; easing: ease-out-back; }
                        drop-shadow-blur: f ? (24px * S.k) : 0;
                        drop-shadow-color: Theme.glow;
                        Image { source: Icons.get(t.icon); colorize: f ? #0a0d18 : Theme.text; width: (34px * S.k); height: (34px * S.k); y: (30px * S.k); }
                        Text { text: t.label; y: (80px * S.k); width: parent.width; horizontal-alignment: center; font-size: (17px * S.k); font-weight: 500; color: f ? #0a0d18 : Theme.text; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.control-center, o + 2 + i); } }
                    }
                }
                Text {
                    x: parent.width - self.width - (96px * S.k);
                    y: (40px * S.k);
                    text: root.clock;
                    font-size: (34px * S.k);
                    font-weight: 600;
                    color: Theme.text;
                }
            }
        }

        // ------------------------------------------------------------ LAUNCH SPLASH
        if root.overlay == 4: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            opacity: entered ? 1 : 0;
            animate opacity { duration: 320ms; easing: ease-out-quad; }
            background: #000000;
            Image {
                source: root.launch-bg;
                width: root.width;
                height: root.height;
                image-fit: cover;
                opacity: 0.45;
            }
            Rectangle { background: @radial-gradient(circle, #00000033 0%, #000000d9 75%); }
            VerticalLayout {
                alignment: center;
                spacing: 0;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (220px * S.k);
                        height: (220px * S.k);
                        border-radius: (28px * S.k);
                        clip: true;
                        background: Theme.panel;
                        Image { source: root.launch-icon; width: parent.width; height: parent.height; image-fit: cover; }
                    }
                }
                Rectangle { height: (34px * S.k); }
                Text { text: root.launch-name; font-size: (44px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Rectangle { height: (10px * S.k); }
                Text { text: root.launch-sub; font-size: (20px * S.k); color: Theme.text2; horizontal-alignment: center; }
                Rectangle { height: (36px * S.k); }
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Icons.spinner;
                        width: (44px * S.k);
                        height: (44px * S.k);
                        transform-rotation: animation-tick() / 1ms * 0.4deg;
                    }
                }
                Rectangle { height: (40px * S.k); }
                if !root.launch-keyboard: Text { text: root.launch-controller; font-size: (18px * S.k); color: Theme.ok; horizontal-alignment: center; }
                if root.launch-keyboard: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: (18px * S.k);
                        background: #0b1124e6;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding-left: (28px * S.k);
                            padding-right: (28px * S.k);
                            padding-top: (20px * S.k);
                            padding-bottom: (20px * S.k);
                            spacing: (14px * S.k);
                            Text { text: @tr("No controller connected: you'll play with the keyboard."); font-size: (18px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                            Text { text: @tr("Games play best with a controller. Connect one before starting a game."); font-size: (16px * S.k); color: Theme.text2; horizontal-alignment: center; }
                            HorizontalLayout {
                                alignment: center;
                                height: (30px * S.k);
                                spacing: (8px * S.k);
                                for k in (root.launch-ps4
                                        ? [{ key: "N", what: "✕" }, { key: "C", what: "△" }, { key: "V", what: "□" }, { key: "B", what: "○" },
                                           { key: "W A S D", what: @tr("Move") }, { key: @tr("Arrows"), what: @tr("D-pad") }, { key: "Enter", what: @tr("Options") }]
                                        : [{ key: "J", what: "✕" }, { key: "I", what: "△" }, { key: "K", what: "□" }, { key: "L", what: "○" },
                                           { key: "W A S D", what: @tr("Move") }, { key: @tr("Arrows"), what: @tr("D-pad") }, { key: "Enter", what: @tr("Options") }]): HorizontalLayout {
                                    spacing: (6px * S.k);
                                    padding-right: (10px * S.k);
                                    KeyCap { text: k.key; }
                                    Text { text: k.what; font-size: (16px * S.k); color: Theme.text2; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ BOOT / WELCOME
        boot := Rectangle {
            property <bool> shown: root.overlay == 6;
            // Motion clock only runs while the screen is up, so it costs nothing afterwards.
            property <float> t: shown ? animation-tick() / 1ms / 1000 : 0;
            opacity: shown ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 600ms; easing: ease-in-out-quad; }
            transform-scale: shown ? 1.0 : 1.04;
            animate transform-scale { duration: 700ms; easing: ease-in-quad; }
            background: #05070f;
            TouchArea { clicked => { root.click(Zone.row, -2); } }

            // A slowly drifting wall of the library's covers.
            property <length> cw: (190px * S.k);
            property <length> ch: (285px * S.k);
            property <length> cg: (22px * S.k);
            property <int> cols: ceil(root.width / (cw + cg)) + 1;
            property <int> rows: ceil(root.height / (ch + cg)) + 2;
            Rectangle {
                opacity: root.boot-covers.length > 0 ? 0.30 : 0;
                animate opacity { duration: 1600ms; easing: ease-out-quad; }
                for c in boot.cols: Rectangle {
                    property <float> speed: 14 + mod(c * 7, 11);            // px/s, each column differs
                    property <length> shift: (boot.t * speed * 1px * S.k) + c * (97px * S.k);
                    property <length> loop-h: boot.rows * (boot.ch + boot.cg);
                    x: c * (boot.cw + boot.cg) - (40px * S.k);
                    width: boot.cw;
                    for r in boot.rows: Rectangle {
                        property <int> k: mod(c * 7 + r * 11, max(1, root.boot-covers.length));
                        y: mod(r * (boot.ch + boot.cg) / 1px - shift / 1px, loop-h / 1px) * 1px - boot.ch;
                        height: boot.ch;
                        border-radius: (14px * S.k);
                        clip: true;
                        background: #121a31;
                        if root.boot-covers.length > 0: Image {
                            source: root.boot-covers[k];
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }
                }
            }
            // Vignette + drifting light keep the centre calm and readable.
            Rectangle { background: @radial-gradient(circle, #05070fd9 0%, #05070fa6 45%, #05070f40 100%); }
            Rectangle {
                x: root.width * (0.30 + 0.06 * sin(boot.t * 9deg)) - self.width / 2;
                y: root.height * (0.35 + 0.05 * cos(boot.t * 7deg)) - self.height / 2;
                width: (1100px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #1f4fd13d 0%, #1f4fd100 65%);
            }
            Rectangle {
                x: root.width * (0.70 + 0.05 * cos(boot.t * 8deg)) - self.width / 2;
                y: root.height * (0.62 + 0.06 * sin(boot.t * 6deg)) - self.height / 2;
                width: (1000px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #8b5cf62e 0%, #8b5cf600 65%);
            }

            VerticalLayout {
                alignment: center;
                spacing: 0;
                // Custom chassis emblem, presented calmly rather than as a pulsing play button.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (132px * S.k);
                        height: self.width;
                        Rectangle {
                            x: -(40px * S.k);
                            y: -(40px * S.k);
                            width: parent.width + (80px * S.k);
                            height: self.width;
                            background: @radial-gradient(circle, #3d8bff66 0%, #3d8bff00 68%);
                            opacity: 0.28;
                        }
                        Image { source: Icons.app; width: parent.width; height: parent.height; image-fit: contain; }
                    }
                }
                Rectangle { height: (24px * S.k); }
                Text { text: root.boot-stick ? "AZRAKOS" : "SWARMPLAY"; font-size: (19px * S.k); font-weight: 600; letter-spacing: (3px * S.k); color: Theme.text2; horizontal-alignment: center; }
                // Every start after the first, as a console's: who's playing, welcomed back.
                if !root.boot-first: VerticalLayout {
                    spacing: 0;
                    property <bool> came: false;
                    init => { self.came = true; }
                    Rectangle { height: (54px * S.k); }
                    HorizontalLayout {
                        alignment: center;
                        av-boot := Rectangle {
                            width: (148px * S.k); height: self.width;
                            border-radius: self.width / 2;
                            background: @linear-gradient(135deg, Theme.accent.brighter(0.35) 0%, Theme.accent.darker(0.45) 100%);
                            border-width: (4px * S.k);
                            border-color: #f5f7fb;
                            drop-shadow-blur: (34px * S.k);
                            drop-shadow-color: Theme.glow;
                            Text { text: root.user-initial; font-size: (64px * S.k); font-weight: 600; color: #ffffff; }
                        }
                    }
                    Rectangle { height: (26px * S.k); }
                    Text {
                        text: root.user-name != "" ? @tr("Welcome back, {}", root.user-name) : @tr("Welcome back");
                        font-size: (40px * S.k); font-weight: 600; color: Theme.text;
                        horizontal-alignment: center;
                    }
                    Rectangle { height: (30px * S.k); }
                }
                Rectangle { height: (18px * S.k); }
                if root.boot-first: Text {
                    text: root.boot-stick ? @tr("Getting AzrakOS ready") : @tr("Welcome");
                    font-size: (64px * S.k);
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                if root.boot-first: Text {
                    text: @tr("Setting up SwarmPlay");
                    font-size: (23px * S.k);
                    color: Theme.text2;
                    horizontal-alignment: center;
                }
                if root.boot-first && root.boot-stick: Rectangle { height: (6px * S.k); }
                if root.boot-first && root.boot-stick: Text {
                    text: @tr("You can install it later from Settings.");
                    font-size: (19px * S.k);
                    color: Theme.text3;
                    horizontal-alignment: center;
                }
                Rectangle { height: root.boot-first ? (44px * S.k) : (6px * S.k); }

                // Step list (first launch only).
                if root.boot-first: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (560px * S.k);
                        height: steps.preferred-height;
                        border-radius: (20px * S.k);
                        background: #0b1122cc;
                        border-width: 1px;
                        border-color: #ffffff17;
                        steps := VerticalLayout {
                            padding: (22px * S.k);
                            spacing: (14px * S.k);
                            for st in root.boot-steps: HorizontalLayout {
                                spacing: (14px * S.k);
                                height: (30px * S.k);
                                Rectangle {
                                    width: (26px * S.k);
                                    height: self.width;
                                    y: (2px * S.k);
                                    border-radius: self.width / 2;
                                    background: st.state == 2 ? Theme.ok.with-alpha(0.18) : st.state == 3 ? Theme.danger.with-alpha(0.18) : #ffffff10;
                                    animate background { duration: 300ms; }
                                    if st.state == 2: Image { source: Icons.check; colorize: Theme.ok; width: (16px * S.k); height: self.width; }
                                    if st.state == 3: Image { source: Icons.alert; colorize: Theme.danger; width: (16px * S.k); height: self.width; }
                                    if st.state == 1: Image {
                                        source: Icons.spinner;
                                        width: (18px * S.k);
                                        height: self.width;
                                        transform-rotation: boot.t * 400deg;
                                    }
                                    if st.state == 0: Rectangle {
                                        width: (6px * S.k);
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: Theme.text3;
                                    }
                                }
                                Text {
                                    text: st.label;
                                    font-size: (19px * S.k);
                                    font-weight: st.state == 1 ? 600 : 500;
                                    color: st.state == 0 ? Theme.text3 : Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: st.detail;
                                    font-size: (17px * S.k);
                                    color: st.state == 2 ? Theme.ok : st.state == 3 ? Theme.danger : Theme.text2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle { height: root.boot-first ? (28px * S.k) : (4px * S.k); }

                // Progress bar with a moving sheen, and the percentage.
                HorizontalLayout {
                    alignment: center;
                    spacing: (16px * S.k);
                    Rectangle {
                        width: root.boot-first ? (480px * S.k) : (360px * S.k);
                        height: (6px * S.k);
                        y: (10px * S.k);
                        border-radius: (3px * S.k);
                        background: #ffffff1a;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.boot-progress;
                            border-radius: (3px * S.k);
                            background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent.brighter(0.5) 60%, Theme.accent.brighter(1.0) 100%);
                            animate width { duration: 400ms; easing: ease-out-quart; }
                            drop-shadow-blur: (12px * S.k);
                            drop-shadow-color: Theme.glow;
                        }
                        Rectangle {
                            x: mod(boot.t * 0.6, 1.4) * parent.width - self.width;
                            width: (120px * S.k);
                            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
                            visible: root.boot-progress < 1;
                        }
                    }
                    if root.boot-first: Text {
                        text: round(root.boot-progress * 100) + "%";
                        font-size: (18px * S.k);
                        font-weight: 600;
                        color: Theme.text2;
                        min-width: (48px * S.k);
                    }
                }
                Rectangle { height: (16px * S.k); }
                Text {
                    text: root.boot-first ? root.boot-detail : root.boot-status;
                    font-size: (16px * S.k);
                    color: Theme.text3;
                    horizontal-alignment: center;
                }
                Rectangle { height: (40px * S.k); }
                if root.boot-first: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: (64px * S.k);
                        width: prompt.preferred-width + (60px * S.k);
                        border-radius: (32px * S.k);
                        background: root.boot-ready ? #ffffff : #ffffff14;
                        border-width: 1px;
                        border-color: #ffffff2e;
                        drop-shadow-blur: root.boot-ready ? (30px * S.k) + (10px * S.k) * sin(boot.t * 150deg) : 0;
                        drop-shadow-color: #8cb9ffaa;
                        transform-scale: root.boot-ready ? 1.0 : 0.96;
                        animate background { duration: 300ms; }
                        animate transform-scale { duration: 500ms; easing: ease-out-back; }
                        prompt := HorizontalLayout {
                            alignment: center;
                            spacing: (12px * S.k);
                            KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; fg: root.boot-ready ? #ffffff : #8fb6ff; bg: root.boot-ready ? #0a0d18 : #ffffff24; y: (17px * S.k); }
                            Text {
                                text: root.boot-ready ? @tr("Start") : @tr("Skip and continue");
                                font-size: (21px * S.k);
                                font-weight: 600;
                                color: root.boot-ready ? #0a0d18 : Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ INSTALL AZRAKOS (USB stick)
        if root.overlay == 11: osi := Rectangle {
            property <float> t: animation-tick() / 1ms / 1000;
            background: #05070f;
            TouchArea {}
            // The library's covers drifting behind, as on the start screen.
            property <length> cw: (190px * S.k);
            property <length> ch: (285px * S.k);
            property <length> cg: (22px * S.k);
            property <int> cols: ceil(root.width / (cw + cg)) + 1;
            property <int> rows: ceil(root.height / (ch + cg)) + 2;
            Rectangle {
                opacity: root.boot-covers.length > 0 ? 0.22 : 0;
                for c in osi.cols: Rectangle {
                    property <float> speed: 10 + mod(c * 7, 9);
                    property <length> shift: (osi.t * speed * 1px * S.k) + c * (97px * S.k);
                    property <length> loop-h: osi.rows * (osi.ch + osi.cg);
                    x: c * (osi.cw + osi.cg) - (40px * S.k);
                    width: osi.cw;
                    for r in osi.rows: Rectangle {
                        property <int> k: mod(c * 7 + r * 11, max(1, root.boot-covers.length));
                        y: mod(r * (osi.ch + osi.cg) / 1px - shift / 1px, loop-h / 1px) * 1px - osi.ch;
                        height: osi.ch;
                        border-radius: (14px * S.k);
                        clip: true;
                        background: #121a31;
                        if root.boot-covers.length > 0: Image { source: root.boot-covers[k]; width: parent.width; height: parent.height; image-fit: cover; }
                    }
                }
            }
            Rectangle { background: @radial-gradient(circle, #05070fe6 0%, #05070fb8 50%, #05070f66 100%); }
            Rectangle {
                x: root.width * (0.5 + 0.08 * sin(osi.t * 8deg)) - self.width / 2;
                y: root.height * (0.42 + 0.05 * cos(osi.t * 6deg)) - self.height / 2;
                width: (1200px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #1f4fd133 0%, #1f4fd100 65%);
            }
            // The start screen's two drifting lights, so the screen is alive even before (or
            // without) covers to drift behind it.
            Rectangle {
                x: root.width * (0.30 + 0.06 * sin(osi.t * 9deg)) - self.width / 2;
                y: root.height * (0.35 + 0.05 * cos(osi.t * 7deg)) - self.height / 2;
                width: (1100px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #1f4fd12e 0%, #1f4fd100 65%);
            }
            Rectangle {
                x: root.width * (0.70 + 0.05 * cos(osi.t * 8deg)) - self.width / 2;
                y: root.height * (0.62 + 0.06 * sin(osi.t * 6deg)) - self.height / 2;
                width: (1000px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #8b5cf62e 0%, #8b5cf600 65%);
            }

            VerticalLayout {
                alignment: center;
                spacing: 0;
                HorizontalLayout {
                    alignment: center;
                    Image { source: Icons.app; width: (104px * S.k); height: self.width; image-fit: contain; }
                }
                Rectangle { height: (20px * S.k); }
                Text { text: "AZRAKOS"; font-size: (18px * S.k); font-weight: 600; letter-spacing: (4px * S.k); color: Theme.text2; horizontal-alignment: center; }
                Rectangle { height: (14px * S.k); }
                Text { text: root.osi-title; font-size: (52px * S.k); font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                if root.osi-sub != "": Rectangle { height: (8px * S.k); }
                if root.osi-sub != "": HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.osi-sub;
                        max-width: (900px * S.k);
                        font-size: (26px * S.k);
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
                Rectangle { height: (14px * S.k); }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.osi-text;
                        width: (780px * S.k);
                        font-size: (22px * S.k);
                        font-weight: root.osi-text-warn ? 700 : 400;
                        color: root.osi-text-warn ? Theme.warn : Theme.text2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: (34px * S.k); }

                // The disks to choose from.
                if root.osi-phase == 1 && root.osi-disks.length > 0: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: (660px * S.k);
                        spacing: (12px * S.k);
                        for d[i] in root.osi-disks: Rectangle {
                            property <bool> f: i == root.osi-sel;
                            height: (84px * S.k);
                            border-radius: (18px * S.k);
                            background: f ? #16234acc : #0b1122cc;
                            border-width: f ? (2px * S.k) : 1px;
                            border-color: f ? Theme.ring : #ffffff17;
                            drop-shadow-blur: f ? (24px * S.k) : 0;
                            drop-shadow-color: Theme.glow;
                            animate background, border-color { duration: Theme.fast; }
                            HorizontalLayout {
                                padding-left: (24px * S.k);
                                padding-right: (24px * S.k);
                                spacing: (18px * S.k);
                                Image { source: Icons.download; colorize: f ? Theme.text : Theme.text2; width: (30px * S.k); height: self.width; y: (27px * S.k); }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: (4px * S.k);
                                    Text { text: d.label; font-size: (21px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                                    Text { text: d.detail; font-size: (17px * S.k); color: d.warn ? Theme.warn : Theme.text2; }
                                }
                            }
                            // The highlight follows the mouse, so it shows what a click (or ✕) does.
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.click(Zone.os-install, i); }
                                changed has-hover => { if self.has-hover { root.hover(Zone.os-install, i); } }
                            }
                        }
                    }
                }
                if root.osi-phase == 1 && root.osi-busy: HorizontalLayout {
                    alignment: center;
                    Image { source: Icons.spinner; width: (28px * S.k); height: self.width; transform-rotation: osi.t * 400deg; }
                }

                // Installing: the progress.
                if root.osi-phase == 3: HorizontalLayout {
                    alignment: center;
                    spacing: (16px * S.k);
                    Rectangle {
                        width: (560px * S.k);
                        height: (8px * S.k);
                        y: (9px * S.k);
                        border-radius: (4px * S.k);
                        background: #ffffff1a;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0.02, root.osi-progress);
                            border-radius: (4px * S.k);
                            background: @linear-gradient(90deg, #2f6dff 0%, #6ea8ff 60%, #b4d0ff 100%);
                            animate width { duration: 600ms; easing: ease-out-quart; }
                            drop-shadow-blur: (12px * S.k);
                            drop-shadow-color: #3d8bff99;
                        }
                        Rectangle {
                            x: mod(osi.t * 0.6, 1.4) * parent.width - self.width;
                            width: (120px * S.k);
                            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
                        }
                    }
                    Text { text: round(root.osi-progress * 100) + "%"; font-size: (18px * S.k); font-weight: 600; color: Theme.text2; min-width: (48px * S.k); }
                }

                if root.osi-note != "": Rectangle { height: root.osi-phase == 3 ? (30px * S.k) : (22px * S.k); }
                if root.osi-note != "": HorizontalLayout {
                    alignment: center;
                    // Installing: "Keep the PC on" is the one thing to know, so it's large.
                    Text {
                        text: root.osi-note;
                        width: (720px * S.k);
                        font-size: root.osi-phase == 3 ? (28px * S.k) : (18px * S.k);
                        font-weight: root.osi-phase == 3 ? 700 : 400;
                        color: root.osi-phase == 2 ? Theme.warn : root.osi-phase == 3 ? Theme.text : Theme.text3;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                if root.osi-small != "": Rectangle { height: (8px * S.k); }
                if root.osi-small != "": HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.osi-small;
                        width: (720px * S.k);
                        font-size: (15px * S.k);
                        color: Theme.text3;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Installed with Secure Boot on: what to press on the blue key screen, one step
                // per line. It takes a keyboard (the controller doesn't work there yet).
                if root.osi-phase == 4 && root.osi-mok: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (680px * S.k);
                        height: mok.preferred-height;
                        border-radius: (18px * S.k);
                        background: #ffb54712;
                        border-width: 1px;
                        border-color: #ffb54759;
                        clip: true;
                        Rectangle { x: 0; width: (5px * S.k); background: Theme.warn; }
                        mok := VerticalLayout {
                            padding: (26px * S.k);
                            padding-left: (34px * S.k);
                            spacing: (10px * S.k);
                            HorizontalLayout {
                                spacing: (10px * S.k);
                                Image { source: Icons.lock; colorize: Theme.warn; width: (22px * S.k); height: self.width; y: (3px * S.k); }
                                Text { text: @tr("Before you restart"); font-size: (24px * S.k); font-weight: 700; color: Theme.warn; }
                            }
                            Text {
                                text: @tr("A blue screen comes up once after the restart. On it, use a keyboard's arrow keys and Enter:");
                                width: (620px * S.k);
                                font-size: (18px * S.k);
                                color: Theme.text2;
                                wrap: word-wrap;
                            }
                            Rectangle { height: (2px * S.k); }
                            for st[n] in [
                                { a: @tr("Choose "), b: "“Enroll MOK”" },
                                { a: "", b: "“Continue”" },
                                { a: "", b: "“Yes”" },
                                { a: @tr("Type the password "), b: "universalblue" },
                                { a: "", b: "“Reboot”" },
                            ]: HorizontalLayout {
                                spacing: (14px * S.k);
                                Rectangle {
                                    width: (28px * S.k);
                                    height: self.width;
                                    border-radius: self.width / 2;
                                    background: #ffb54726;
                                    Text { text: n + 1; font-size: (15px * S.k); font-weight: 700; color: Theme.warn; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    if st.a != "": Text { text: st.a; font-size: (20px * S.k); color: Theme.text2; vertical-alignment: center; }
                                    Text { text: st.b; font-size: (20px * S.k); font-weight: 700; color: n == 3 ? Theme.warn : Theme.text; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: (4px * S.k); }
                            Text {
                                text: @tr("This lets NVIDIA's graphics driver start. Skipped it? AzrakOS still starts; the PC asks again later.");
                                width: (620px * S.k);
                                font-size: (16px * S.k);
                                color: Theme.text3;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle { height: (40px * S.k); }

                HorizontalLayout {
                    alignment: center;
                    spacing: (16px * S.k);
                    for b[j] in root.osi-buttons: Rectangle {
                        property <int> i: root.osi-button-base + j;
                        property <bool> f: i == root.osi-sel;
                        property <bool> danger: root.osi-phase == 2 && j == 0;
                        height: (62px * S.k);
                        width: bl.preferred-width + (56px * S.k);
                        border-radius: (31px * S.k);
                        // Erasing stays red even unfocused, so it never passes for a harmless button.
                        background: f ? (danger ? Theme.danger : #ffffff) : (danger ? #ff5a6a26 : #ffffff14);
                        border-width: danger ? (2px * S.k) : 1px;
                        border-color: danger ? Theme.danger : #ffffff2e;
                        drop-shadow-blur: f ? (26px * S.k) + (6px * S.k) * sin(osi.t * 150deg) : 0;
                        drop-shadow-color: danger ? #ff5a6a88 : #8cb9ffaa;
                        transform-scale: f ? 1.0 : 0.97;
                        animate background { duration: 200ms; }
                        animate transform-scale { duration: 300ms; easing: ease-out-back; }
                        bl := HorizontalLayout {
                            alignment: center;
                            spacing: (12px * S.k);
                            if f: KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; fg: #ffffff; bg: #0a0d18; y: (16px * S.k); }
                            Text { text: b; font-size: (20px * S.k); font-weight: 600; color: f ? (danger ? #ffffff : #0a0d18) : (danger ? #ff8f9c : Theme.text); vertical-alignment: center; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.click(Zone.os-install, parent.i); }
                            changed has-hover => { if self.has-hover { root.hover(Zone.os-install, parent.i); } }
                        }
                    }
                }
            }

            // Where Back goes is never on screen as a button (disks, last check, failed): its
            // key is, like on the launcher's other screens. Clicking it goes back too.
            if root.osi-phase == 1 || root.osi-phase == 2 || root.osi-phase == 5: Rectangle {
                x: root.width - self.width - (76px * S.k);
                y: root.height - self.height - (30px * S.k);
                width: osi-hint.preferred-width;
                height: (50px * S.k);
                border-radius: (25px * S.k);
                background: #070a14e6;
                border-width: 1px;
                border-color: Theme.line;
                osi-hint := HorizontalLayout {
                    padding-left: (20px * S.k);
                    padding-right: (22px * S.k);
                    spacing: (10px * S.k);
                    alignment: center;
                    KeyCap { text: root.pad-hints ? "○" : "Esc"; round: root.pad-hints; fg: root.pad-hints ? #ff8f9c : #ffffff; y: (10px * S.k); }
                    Text { text: @tr("Back"); font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.os-install, -1); } }
            }
        }

        // ------------------------------------------------------------ JOIN A WI-FI NETWORK
        // The Library's search on a controller: docked at the bottom, the results above it.
        if root.overlay == 14: sk := Rectangle {
            property <length> key: (64px * S.k);
            property <length> gap: (8px * S.k);
            property <length> keys-width: sk.key * 10 + sk.gap * 9;
            TouchArea { clicked => { root.click(Zone.search-keys, -1); } }
            Rectangle {
                y: parent.height - self.height;
                height: panel.preferred-height;
                background: @linear-gradient(180deg, #151926f5 0%, #090b12fc 100%);
                drop-shadow-blur: (48px * S.k);
                drop-shadow-color: #000000cc;
                Rectangle { y: 0; height: 1px; background: Theme.line; }
                TouchArea {}
                panel := VerticalLayout {
                    padding-top: (22px * S.k);
                    padding-bottom: (20px * S.k);
                    spacing: (10px * S.k);
                    // What's typed, and what it finds.
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: sk.keys-width;
                            height: (58px * S.k);
                            border-radius: (29px * S.k);
                            background: #ffffff1f;
                            border-width: (3px * S.k);
                            border-color: #f5f7fb;
                            HorizontalLayout {
                                padding-left: (22px * S.k);
                                padding-right: (24px * S.k);
                                spacing: (14px * S.k);
                                Image { source: Icons.search; colorize: Theme.text2; width: (24px * S.k); height: self.width; y: (parent.height - self.height) / 2; }
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    alignment: start;
                                    if root.query != "": Text {
                                        text: root.query;
                                        font-size: (24px * S.k);
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // The caret: letters go in here.
                                    Rectangle { width: (2px * S.k); height: (28px * S.k); y: (parent.height - self.height) / 2; background: Theme.accent; }
                                    if root.query == "": Text {
                                        text: "  " + @tr("A name, initials (tlou) or a genre");
                                        font-size: (22px * S.k);
                                        color: Theme.text3;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.sk-count;
                                    font-size: (18px * S.k);
                                    color: root.sk-count-warn ? Theme.warn : Theme.text2;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                    // Recent searches, or the best matches to open straight away.
                    if root.sk-suggestions.length > 0: VerticalLayout {
                        spacing: (6px * S.k);
                        HorizontalLayout {
                            alignment: center;
                            Text { width: sk.keys-width; text: root.sk-suggestions-label; font-size: (15px * S.k); font-weight: 600; color: Theme.text3; }
                        }
                        HorizontalLayout {
                            spacing: sk.gap;
                            alignment: center;
                            for k[c] in root.sk-suggestions: KeyboardKey {
                                k: k;
                                unit: sk.key;
                                gap: sk.gap;
                                height: (56px * S.k);
                                two-lines: true;
                                clicked => { root.click(Zone.search-keys, c); }
                            }
                        }
                    }
                    Rectangle { height: (2px * S.k); }
                    VerticalLayout {
                        spacing: sk.gap;
                        for row[r] in [root.sk-row1, root.sk-row2, root.sk-row3, root.sk-row4, root.sk-actions]: HorizontalLayout {
                            spacing: sk.gap;
                            alignment: center;
                            for k[c] in row: KeyboardKey {
                                k: k;
                                unit: sk.key;
                                gap: sk.gap;
                                height: r == 4 ? (56px * S.k) : (52px * S.k);
                                clicked => { root.click(Zone.search-keys, (r + 1) * 100 + c); }
                            }
                        }
                    }
                    // The buttons that do the same without moving there.
                    HorizontalLayout {
                        alignment: center;
                        spacing: (22px * S.k);
                        padding-top: (6px * S.k);
                        for h in root.pad-hints
                            ? [{ key: "□", what: @tr("Delete") }, { key: "△", what: @tr("Space") }, { key: "R2", what: @tr("Show results") }, { key: "○", what: @tr("Close") }]
                            : [{ key: "Enter", what: root.sk-enter-done ? @tr("Show results") : @tr("Press the key") }, { key: "Esc", what: @tr("Close") }]: HorizontalLayout {
                            spacing: (8px * S.k);
                            KeyCap { text: h.key; round: root.pad-hints && h.key.character-count == 1; }
                            Text { text: h.what; font-size: (17px * S.k); color: Theme.hint; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        if root.overlay == 12: wj := Rectangle {
            property <float> t: animation-tick() / 1ms / 1000;
            property <length> key: (74px * S.k);
            property <length> gap: (10px * S.k);
            background: #03050cd9;
            TouchArea { clicked => { root.click(Zone.wifi-join, -1); } }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: (26px * S.k);
                        background: @linear-gradient(180deg, #121c38 0%, #0a1024 100%);
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: (60px * S.k);
                        drop-shadow-color: #000000aa;
                        TouchArea {}
                        VerticalLayout {
                            padding: (40px * S.k);
                            spacing: 0;
                            // The network.
                            HorizontalLayout {
                                spacing: (18px * S.k);
                                Rectangle {
                                    width: (58px * S.k);
                                    height: self.width;
                                    border-radius: (16px * S.k);
                                    background: Theme.accent.with-alpha(0.16);
                                    Image { source: Icons.wifi; colorize: #8fb6ff; width: (30px * S.k); height: self.width; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: (4px * S.k);
                                    Text { text: @tr("Join {}", root.wj-ssid); font-size: (30px * S.k); font-weight: 700; color: Theme.text; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: (6px * S.k);
                                        alignment: start;
                                        Image { source: Icons.lock; colorize: Theme.hint; width: (16px * S.k); height: self.width; y: (2px * S.k); }
                                        Text { text: root.wj-sub; font-size: (18px * S.k); color: Theme.hint; }
                                    }
                                }
                            }
                            Rectangle { height: (28px * S.k); }
                            // The password.
                            Rectangle {
                                height: (68px * S.k);
                                border-radius: (16px * S.k);
                                background: #050913;
                                border-width: root.wj-error != "" ? (2px * S.k) : 1px;
                                border-color: root.wj-error != "" ? Theme.danger : #3d8bff88;
                                drop-shadow-blur: (18px * S.k);
                                drop-shadow-color: root.wj-error != "" ? #ff5a6a33 : #3d8bff33;
                                HorizontalLayout {
                                    padding-left: (22px * S.k);
                                    padding-right: (22px * S.k);
                                    spacing: (4px * S.k);
                                    alignment: start;
                                    // Before the placeholder, after what's typed.
                                    if !root.wj-busy && root.wj-field == "": Rectangle {
                                        width: (2px * S.k);
                                        height: (30px * S.k);
                                        y: (19px * S.k);
                                        background: #8fb6ff;
                                        opacity: mod(wj.t, 1.0) < 0.55 ? 1 : 0;
                                    }
                                    if root.wj-field == "": Text {
                                        text: @tr("Password");
                                        font-size: (22px * S.k);
                                        color: Theme.text3;
                                        vertical-alignment: center;
                                    }
                                    if root.wj-field != "": Text {
                                        text: root.wj-field;
                                        font-size: (24px * S.k);
                                        letter-spacing: root.wj-show ? 0 : (5px * S.k);
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // The caret, blinking while it waits for the next key.
                                    if !root.wj-busy && root.wj-field != "": Rectangle {
                                        width: (2px * S.k);
                                        height: (30px * S.k);
                                        y: (19px * S.k);
                                        background: #8fb6ff;
                                        opacity: mod(wj.t, 1.0) < 0.55 ? 1 : 0;
                                    }
                                }
                            }
                            Rectangle { height: (14px * S.k); }
                            // What's happening: connecting, a wrong password, or how to type.
                            HorizontalLayout {
                                height: (24px * S.k);
                                spacing: (10px * S.k);
                                if root.wj-busy: Image { source: Icons.spinner; width: (20px * S.k); height: self.width; y: (2px * S.k); transform-rotation: wj.t * 400deg; }
                                Text {
                                    text: root.wj-busy ? @tr("Connecting to {}…", root.wj-ssid) : root.wj-error != "" ? root.wj-error : root.wj-note != "" ? root.wj-note
                                        : root.pad-hints ? @tr("Choose the letters below") : @tr("Type with your keyboard, or choose the letters below");
                                    font-size: (17px * S.k);
                                    color: root.wj-busy ? Theme.text2 : root.wj-error != "" ? Theme.danger : root.wj-note != "" ? Theme.warn : Theme.text2;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { height: (22px * S.k); }
                            // The keyboard.
                            VerticalLayout {
                                spacing: wj.gap;
                                opacity: root.wj-busy ? 0.4 : 1;
                                animate opacity { duration: 200ms; }
                                for row[r] in [root.wj-row0, root.wj-row1, root.wj-row2, root.wj-row3, root.wj-row4]: HorizontalLayout {
                                    spacing: wj.gap;
                                    alignment: center;
                                    for k[c] in row: KeyboardKey {
                                        k: k;
                                        unit: wj.key;
                                        gap: wj.gap;
                                        height: r == 4 ? (62px * S.k) : (58px * S.k);
                                        clicked => { root.click(Zone.wifi-join, r * 100 + c); }
                                    }
                                }
                            }
                            Rectangle { height: (24px * S.k); }
                            // The buttons that do the same without moving there. None of them does
                            // anything while connecting (it can't be cancelled), so they fade out.
                            HorizontalLayout {
                                alignment: center;
                                spacing: (22px * S.k);
                                opacity: root.wj-busy ? 0 : 1;
                                animate opacity { duration: 200ms; }
                                for h in root.pad-hints
                                    ? [{ key: "□", what: @tr("Delete") }, { key: "△", what: @tr("Space") }, { key: "L1", what: @tr("Shift") }, { key: "R1", what: @tr("Symbols") }, { key: "R2", what: @tr("Join") }, { key: "○", what: @tr("Cancel") }]
                                    : [{ key: "Enter", what: root.wj-enter-joins ? @tr("Join") : @tr("Press the key") }, { key: "Tab", what: root.wj-show ? @tr("Hide password") : @tr("Show password") }, { key: "Esc", what: @tr("Cancel") }]: HorizontalLayout {
                                    spacing: (8px * S.k);
                                    KeyCap { text: h.key; round: root.pad-hints && h.key.character-count == 1; }
                                    Text { text: h.what; font-size: (17px * S.k); color: Theme.hint; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ RESTART NOW? / SHUT DOWN NOW?
        if root.overlay == 13: pw := Rectangle {
            property <float> t: animation-tick() / 1ms / 1000;
            property <bool> entered: false;
            init => { entered = true; }
            background: entered ? #03050cd9 : #03050c00;
            animate background { duration: 200ms; }
            TouchArea { clicked => { root.click(Zone.power, -1); } }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (680px * S.k);
                        border-radius: (26px * S.k);
                        background: @linear-gradient(180deg, #121c38 0%, #0a1024 100%);
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: (60px * S.k);
                        drop-shadow-color: #000000aa;
                        opacity: pw.entered ? 1 : 0;
                        transform-scale: pw.entered ? 1.0 : 0.94;
                        animate opacity { duration: 180ms; easing: ease-out-quad; }
                        animate transform-scale { duration: 320ms; easing: ease-out-back; }
                        TouchArea {}
                        VerticalLayout {
                            padding: (44px * S.k);
                            spacing: 0;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: (64px * S.k);
                                    height: self.width;
                                    border-radius: (18px * S.k);
                                    background: root.power-danger ? Theme.danger.with-alpha(0.16) : Theme.accent.with-alpha(0.16);
                                    if root.power-busy: Image { source: Icons.spinner; width: (32px * S.k); height: self.width; transform-rotation: pw.t * 400deg; }
                                    if !root.power-busy: Image { source: Icons.power; colorize: root.power-danger ? #ff8f9c : #8fb6ff; width: (32px * S.k); height: self.width; }
                                }
                            }
                            Rectangle { height: (22px * S.k); }
                            Text { text: root.power-title; font-size: (34px * S.k); font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                            Rectangle { height: (10px * S.k); }
                            Text { text: root.power-text; font-size: (20px * S.k); color: Theme.text2; horizontal-alignment: center; wrap: word-wrap; }
                            if !root.power-busy: Rectangle { height: (34px * S.k); }
                            if !root.power-busy: HorizontalLayout {
                                alignment: center;
                                spacing: (16px * S.k);
                                for b[i] in root.power-buttons: Rectangle {
                                    property <bool> f: i == root.power-sel;
                                    property <bool> danger: root.power-danger && i == 0;
                                    height: (62px * S.k);
                                    width: max((180px * S.k), pl.preferred-width + (56px * S.k));
                                    border-radius: (31px * S.k);
                                    background: f ? (danger ? Theme.danger : #ffffff) : #ffffff14;
                                    border-width: 1px;
                                    border-color: #ffffff2e;
                                    drop-shadow-blur: f ? (26px * S.k) : 0;
                                    drop-shadow-color: danger ? #ff5a6a88 : #8cb9ffaa;
                                    transform-scale: f ? 1.0 : 0.97;
                                    animate background { duration: 200ms; }
                                    animate transform-scale { duration: 300ms; easing: ease-out-back; }
                                    pl := HorizontalLayout {
                                        alignment: center;
                                        spacing: (12px * S.k);
                                        if f: KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; fg: #ffffff; bg: #0a0d18; y: (16px * S.k); }
                                        Text { text: b; font-size: (20px * S.k); font-weight: 600; color: f ? (danger ? #ffffff : #0a0d18) : Theme.text; vertical-alignment: center; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.power, i); } }
                                }
                            }
                            if !root.power-busy: Rectangle { height: (24px * S.k); }
                            if !root.power-busy: HorizontalLayout {
                                alignment: center;
                                spacing: (10px * S.k);
                                KeyCap { text: root.pad-hints ? "○" : "Esc"; round: root.pad-hints; fg: root.pad-hints ? #ff8f9c : #ffffff; }
                                Text { text: @tr("Cancel"); font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ TRAILER PLAYER
        if root.overlay == 9: Rectangle {
            background: #000000;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.trailer-frame;
                image-fit: contain;
            }
            TouchArea {
                clicked => { root.trailer-action("toggle"); }
                moved => { root.trailer-action("controls"); }
            }
            if root.trailer-loading: Text {
                text: @tr("Loading trailer…");
                font-size: (22px * S.k);
                color: Theme.text2;
            }
            if root.trailer-paused && !root.trailer-loading: Rectangle {
                width: (96px * S.k);
                height: self.width;
                border-radius: self.width / 2;
                background: #00000099;
                border-width: 1px;
                border-color: #ffffff33;
                Image { source: Icons.play; colorize: Theme.text; width: (40px * S.k); height: self.width; }
            }
            // Top: what's playing.
            Rectangle {
                y: 0;
                height: (150px * S.k);
                opacity: root.trailer-controls ? 1 : 0;
                animate opacity { duration: 300ms; easing: ease-out-quad; }
                background: @linear-gradient(180deg, #000000cc 0%, #00000000 100%);
                BackButton {
                    x: (48px * S.k);
                    y: (36px * S.k);
                    pad: root.pad-hints;
                    clicked => { root.trailer-action("close"); }
                }
                VerticalLayout {
                    x: (48px * S.k);
                    y: (84px * S.k);
                    spacing: (2px * S.k);
                    Text { text: @tr("Trailer"); font-size: (17px * S.k); font-weight: 500; color: Theme.hint; }
                    Text { text: root.trailer-title; font-size: (26px * S.k); font-weight: 600; color: Theme.text; }
                }
            }
            // Bottom: progress and what the buttons do.
            Rectangle {
                y: parent.height - self.height;
                height: (150px * S.k);
                opacity: root.trailer-controls ? 1 : 0;
                animate opacity { duration: 300ms; easing: ease-out-quad; }
                background: @linear-gradient(0deg, #000000cc 0%, #00000000 100%);
                Rectangle {
                    x: (48px * S.k);
                    y: (62px * S.k);
                    width: parent.width - (96px * S.k);
                    height: (6px * S.k);
                    border-radius: (3px * S.k);
                    background: #ffffff33;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.trailer-progress, 0, 1);
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.accent.brighter(0.3);
                    }
                    TouchArea {
                        y: -(12px * S.k);
                        height: parent.height + (24px * S.k);
                        mouse-cursor: pointer;
                        clicked => { root.trailer-action("seek:" + (self.mouse-x / self.width)); }
                    }
                }
                Text {
                    x: (48px * S.k);
                    y: (86px * S.k);
                    text: root.trailer-time;
                    font-size: (17px * S.k);
                    color: Theme.text2;
                }
                HorizontalLayout {
                    width: self.preferred-width;
                    height: (30px * S.k);
                    x: parent.width - self.width - (48px * S.k);
                    y: (82px * S.k);
                    spacing: (10px * S.k);
                    KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; }
                    Text { text: root.trailer-paused ? @tr("Trailer" => "Play") : @tr("Trailer" => "Pause"); font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    Rectangle { width: (14px * S.k); }
                    KeyCap { text: "◂ ▸"; }
                    Text { text: "10 s"; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    Rectangle { width: (14px * S.k); }
                    KeyCap { text: root.pad-hints ? "○" : "Esc"; round: root.pad-hints; }
                    Text { text: @tr("Close"); font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                }
            }
        }

        // ------------------------------------------------------------ NOTIFICATION
        // A small card at the top right, over everything: slides in, goes after five seconds
        // (src/toast.rs). Clicked, it goes at once.
        // Up to three, newest on top; the ones under it a little smaller and dimmer, as on a
        // console. Clicked: where it leads (or the list).
        for t[i] in root.toasts: toast-card := Rectangle {
            property <bool> came: false;
            init => { self.came = true; }
            property <color> tone: t.kind == 1 ? Theme.ok : t.kind == 2 ? Theme.warn : t.kind == 3 ? Theme.danger : Theme.accent;
            width: min((460px * S.k), root.width - (64px * S.k));
            height: (84px * S.k);
            x: root.width - self.width - (self.came ? (96px * S.k) : (40px * S.k));
            y: (108px * S.k) + i * (94px * S.k);
            opacity: self.came ? 1 : 0;
            transform-scale: i == 0 ? 1 : 0.96;
            animate x { duration: 420ms; easing: ease-out-expo; }
            animate y, transform-scale { duration: 260ms; easing: ease-out-quart; }
            animate opacity { duration: 240ms; easing: ease-out-quad; }
            border-radius: (18px * S.k);
            background: ta-toast.has-hover ? #252a3a : #1a1e2b;
            border-width: 1px;
            border-color: #ffffff1f;
            drop-shadow-blur: (32px * S.k);
            drop-shadow-color: #00000099;
            HorizontalLayout {
                padding-left: (18px * S.k); padding-right: (20px * S.k);
                spacing: (16px * S.k);
                Rectangle {
                    width: (48px * S.k); height: self.width; y: (18px * S.k);
                    border-radius: self.width / 2;
                    background: toast-card.tone.with-alpha(0.22);
                    Image { source: Icons.get(t.icon); colorize: toast-card.tone; width: (24px * S.k); height: self.width; }
                }
                VerticalLayout {
                    alignment: center; spacing: (3px * S.k);
                    horizontal-stretch: 1;
                    Text { text: t.title; font-size: (19px * S.k); font-weight: 600; color: Theme.text; overflow: elide; }
                    if t.sub != "": Text { text: t.sub; font-size: (16px * S.k); color: Theme.text2; overflow: elide; }
                }
                Text { text: t.time; font-size: (14px * S.k); color: Theme.text3; vertical-alignment: center; }
            }
            // The older ones dimmed, but still solid: what's under them doesn't show through.
            Rectangle {
                border-radius: parent.border-radius;
                background: #0a0d16;
                opacity: i == 0 ? 0 : 0.42;
                animate opacity { duration: 260ms; easing: ease-out-quart; }
            }
            ta-toast := TouchArea { mouse-cursor: pointer; clicked => { root.toast-click(t.id); } }
        }
        if root.toasts.length > 0 && root.overlay == 0: Text {
            x: root.width - self.width - (100px * S.k);
            y: (108px * S.k) + root.toasts.length * (94px * S.k) + (2px * S.k);
            text: root.pad-hints ? @tr("PS  to see it") : @tr("Click to open");
            font-size: (14px * S.k); color: Theme.hint;
        }

        // ------------------------------------------------------------ NOTIFICATIONS
        // The list (src/toast.rs), as a console's: Today and Earlier, the chosen row outlined.
        if root.overlay == 17: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            property <bool> on: entered && root.closing != 17;
            opacity: on ? 1 : 0;
            transform-scale: on ? 1 : 0.985;
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate transform-scale { duration: 420ms; easing: ease-out-expo; }
            Wallpaper { kind: root.wallpaper-kind == 0 ? 1 : root.wallpaper-kind; image: root.wallpaper-image; }
            Rectangle { background: @linear-gradient(180deg, #04060ecc 0%, #04060ee6 40%, #04060ef2 100%); }
            TouchArea {}
            HorizontalLayout {
                x: (96px * S.k); y: (40px * S.k); height: (64px * S.k);
                spacing: (18px * S.k); alignment: start;
                Image { source: Icons.bell; colorize: Theme.text; width: (34px * S.k); height: self.width; y: (15px * S.k); }
                Text { text: @tr("Notifications"); font-size: (36px * S.t); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }
            if root.notes.length == 0: VerticalLayout {
                y: (root.height - self.height) / 2; width: root.width; height: self.preferred-height;
                spacing: (12px * S.k);
                HorizontalLayout { alignment: center;
                    Rectangle { width: (96px * S.k); height: self.width; border-radius: self.width / 2; background: #ffffff12;
                        Image { source: Icons.bell; colorize: Theme.text2; width: (44px * S.k); height: self.width; } } }
                Text { text: @tr("No notifications"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Text { text: @tr("Downloads, games ready to play and updates show up here."); font-size: (19px * S.k); color: Theme.text2; horizontal-alignment: center; }
            }
            if root.notes.length > 0: Flickable {
                property <length> w: min((1080px * S.k), root.width - (192px * S.k));
                x: (root.width - self.w) / 2 - (4px * S.k);
                y: (130px * S.k);
                width: self.w + (8px * S.k);
                height: root.height - self.y - (90px * S.k);
                // The chosen row in view.
                content-y: -max(0px, min(root.idx * (82px * S.k) - self.height / 2, list-n.preferred-height - self.height));
                animate content-y { duration: 260ms; easing: ease-out-quart; }
                interactive: false;
                list-n := VerticalLayout {
                    width: parent.width;
                    padding: (4px * S.k);
                    spacing: 0;
                    for n[i] in root.notes: VerticalLayout {
                        property <bool> f: root.zone == Zone.notes && root.idx == i;
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 240ms; delay: min(i, 10) * 25ms; easing: ease-out-quad; }
                        if n.group != "": Text {
                            text: n.group == "TODAY" ? @tr("Today") : @tr("Earlier");
                            height: (44px * S.k); vertical-alignment: bottom;
                            font-size: (17px * S.k); font-weight: 600; color: Theme.hint;
                        }
                        Rectangle {
                            height: (78px * S.k);
                            border-radius: (14px * S.k);
                            background: f ? #ffffff1c : ta-n.has-hover ? #ffffff0d : transparent;
                            border-width: (3px * S.k);
                            border-color: f ? #f5f7fb : #f5f7fb00;
                            animate background, border-color { duration: 160ms; }
                            if !f: Rectangle { x: (20px * S.k); y: parent.height - 1px; width: parent.width - (40px * S.k); height: 1px; background: #ffffff14; }
                            HorizontalLayout {
                                padding-left: (22px * S.k); padding-right: (22px * S.k);
                                spacing: (18px * S.k);
                                Rectangle {
                                    width: (44px * S.k); height: self.width; y: (17px * S.k);
                                    border-radius: self.width / 2;
                                    background: (n.kind == 1 ? Theme.ok : n.kind == 2 ? Theme.warn : n.kind == 3 ? Theme.danger : Theme.accent).with-alpha(0.22);
                                    Image { source: Icons.get(n.icon); colorize: n.kind == 1 ? Theme.ok : n.kind == 2 ? Theme.warn : n.kind == 3 ? Theme.danger : Theme.accent.brighter(0.3); width: (22px * S.k); height: self.width; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: (2px * S.k); horizontal-stretch: 1;
                                    Text { text: n.title; font-size: (20px * S.k); font-weight: n.unread ? 700 : 500; color: Theme.text; overflow: elide; }
                                    if n.body != "": Text { text: n.body; font-size: (16px * S.k); color: Theme.text2; overflow: elide; }
                                }
                                Text { text: n.age; font-size: (15px * S.k); color: Theme.text3; vertical-alignment: center; }
                                if n.unread: Rectangle { width: (10px * S.k); height: self.width; y: (34px * S.k); border-radius: self.width / 2; background: Theme.accent; }
                            }
                            ta-n := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.notes, i); } }
                        }
                    }
                    // Clear all, at the end.
                    Rectangle {
                        property <bool> f: root.zone == Zone.notes && root.idx == root.notes.length;
                        height: (64px * S.k);
                        border-radius: (14px * S.k);
                        background: f ? #ff5a6a33 : ta-c.has-hover ? #ffffff0d : transparent;
                        border-width: (3px * S.k);
                        border-color: f ? #ff8a9a : #ff8a9a00;
                        animate background, border-color { duration: 160ms; }
                        Text { x: (22px * S.k); text: @tr("Clear all"); font-size: (19px * S.k); font-weight: 500; color: #ff8a9a; vertical-alignment: center; }
                        ta-c := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.notes, root.notes.length); } }
                    }
                }
            }
            HorizontalLayout {
                x: root.width - self.width - (96px * S.k); y: root.height - (60px * S.k);
                width: self.preferred-width; height: (26px * S.k);
                spacing: (22px * S.k);
                for h in root.pad-hints ? [{ k: "✕", l: @tr("Open") }, { k: "□", l: @tr("Delete") }, { k: "○", l: @tr("Back") }] : [{ k: "Enter", l: @tr("Open") }, { k: "T", l: @tr("Delete") }, { k: "Esc", l: @tr("Back") }]: HorizontalLayout {
                    spacing: (8px * S.k);
                    KeyCap { text: h.k; round: root.pad-hints; }
                    Text { text: h.l; font-size: (16px * S.k); color: Theme.hint; vertical-alignment: center; }
                }
            }
        }

        // ------------------------------------------------------------ DRIVES AND FOLDERS
        // Choosing where games go with a controller (src/folder_pick.rs): the drives, then the
        // folders on the one chosen, "Use this folder" first. A page of its own, as a console's.
        if root.overlay == 18: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            property <bool> on: entered && root.closing != 18;
            opacity: on ? 1 : 0;
            transform-scale: on ? 1 : 0.985;
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate transform-scale { duration: 420ms; easing: ease-out-expo; }
            Wallpaper { kind: root.wallpaper-kind == 0 ? 1 : root.wallpaper-kind; image: root.wallpaper-image; }
            Rectangle { background: @linear-gradient(180deg, #04060ecc 0%, #04060ee6 40%, #04060ef2 100%); }
            TouchArea {}
            HorizontalLayout {
                x: (96px * S.k); y: (40px * S.k); height: (64px * S.k);
                spacing: (18px * S.k); alignment: start;
                Rectangle {
                    width: (52px * S.k); height: self.width; y: (6px * S.k);
                    border-radius: self.width / 2;
                    background: ta-pb.has-hover ? #ffffff2e : #ffffff17;
                    Image { source: Icons.chevl; colorize: Theme.text; width: (24px * S.k); height: self.width; }
                    ta-pb := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.pick, -1); } }
                }
                Text { text: root.pick-title; font-size: (36px * S.t); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }
            property <length> w: min((1080px * S.k), root.width - (192px * S.k));
            // Where it is: the drive › folders, and its room.
            Text {
                x: (root.width - parent.w) / 2; y: (128px * S.k);
                width: parent.w;
                // The drives' intro (what they're chosen for), then where the picker is.
                text: root.pick-path;
                font-size: (18px * S.k); color: Theme.text2; overflow: elide;
            }
            if root.pick-note != "": Text {
                x: (root.width - parent.w) / 2; y: (158px * S.k);
                width: parent.w;
                text: root.pick-note;
                font-size: (17px * S.k); color: Theme.danger; overflow: elide;
            }
            Flickable {
                x: (root.width - parent.w) / 2 - (4px * S.k);
                y: (196px * S.k);
                width: parent.w + (8px * S.k);
                height: root.height - self.y - (90px * S.k);
                content-y: -max(0px, min(root.idx * (82px * S.k) - self.height / 2, list-p.preferred-height - self.height));
                animate content-y { duration: 260ms; easing: ease-out-quart; }
                interactive: false;
                list-p := VerticalLayout {
                    width: parent.width;
                    padding: (4px * S.k);
                    spacing: (4px * S.k);
                    for r[i] in root.pick-rows: Rectangle {
                        property <bool> f: root.zone == Zone.pick && root.idx == i;
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 220ms; delay: min(i, 10) * 20ms; easing: ease-out-quad; }
                        height: (78px * S.k);
                        border-radius: (14px * S.k);
                        background: f ? #ffffff1c : ta-p.has-hover ? #ffffff0d : transparent;
                        border-width: (3px * S.k);
                        border-color: f ? #f5f7fb : #f5f7fb00;
                        animate background, border-color { duration: 160ms; }
                        if !f: Rectangle { x: (20px * S.k); y: parent.height - 1px; width: parent.width - (40px * S.k); height: 1px; background: #ffffff14; }
                        HorizontalLayout {
                            padding-left: (22px * S.k); padding-right: (22px * S.k);
                            spacing: (18px * S.k);
                            Rectangle {
                                width: (46px * S.k); height: self.width; y: (16px * S.k);
                                border-radius: r.kind == 0 ? (12px * S.k) : self.width / 2;
                                background: r.kind == 1 ? (r.warn ? Theme.danger.with-alpha(0.22) : Theme.accent.with-alpha(0.3)) : #ffffff14;
                                Image {
                                    source: Icons.get(r.icon);
                                    colorize: r.kind == 1 ? (r.warn ? Theme.danger : Theme.accent.brighter(0.4)) : r.kind == 2 ? #f2c46d : Theme.text;
                                    width: (22px * S.k); height: self.width;
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: (2px * S.k); horizontal-stretch: 1;
                                Text { text: r.label; font-size: (20px * S.k); font-weight: r.kind == 1 ? 600 : 500; color: Theme.text; overflow: elide; }
                                if r.sub != "": Text { text: r.sub; font-size: (16px * S.k); color: r.warn && r.kind == 1 ? Theme.danger : Theme.text2; overflow: elide; }
                            }
                            if r.has-bar: Rectangle {
                                width: (200px * S.k); height: (8px * S.k);
                                y: (parent.height - self.height) / 2;
                                border-radius: (4px * S.k);
                                background: #ffffff1f;
                                Rectangle {
                                    x: 0; width: parent.width * clamp(r.bar, 0, 1); height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: r.warn ? Theme.warn : StorageColors.parts[0];
                                }
                            }
                            if r.kind != 1: Image { y: (parent.height - self.height) / 2; source: Icons.chevr; colorize: #9ba6c0; width: (18px * S.k); height: self.width; }
                        }
                        ta-p := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.pick, i); } }
                    }
                    if root.pick-step == 1 && root.pick-rows.length == 1: Text {
                        height: (60px * S.k);
                        x: (22px * S.k);
                        text: @tr("No folders in here");
                        font-size: (17px * S.k); color: Theme.hint; vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                x: root.width - self.width - (96px * S.k); y: root.height - (60px * S.k);
                width: self.preferred-width; height: (26px * S.k);
                spacing: (22px * S.k);
                for h in root.pick-step == 0
                    ? (root.pad-hints ? [{ k: "✕", l: @tr("Open") }, { k: "○", l: @tr("Back") }] : [{ k: "Enter", l: @tr("Open") }, { k: "Esc", l: @tr("Back") }])
                    : (root.pad-hints ? [{ k: "✕", l: @tr("Open") }, { k: "△", l: @tr("Use this folder") }, { k: "○", l: @tr("Up") }] : [{ k: "Enter", l: @tr("Open") }, { k: "/", l: @tr("Use this folder") }, { k: "Esc", l: @tr("Up") }]): HorizontalLayout {
                    spacing: (8px * S.k);
                    KeyCap { text: h.k; round: root.pad-hints; }
                    Text { text: h.l; font-size: (16px * S.k); color: Theme.hint; vertical-alignment: center; }
                }
            }
        }

        // ------------------------------------------------------------ KEYBOARD CONTROLS
        if root.overlay == 10: Rectangle {
            property <bool> entered: false;
            init => { self.entered = true; }
            opacity: self.entered && root.closing != 10 ? 1 : 0;
            animate opacity { duration: 220ms; easing: ease-out-quad; }
            background: #03050ccc;
            TouchArea { clicked => { root.click(Zone.controls, -1); } }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                alignment: center;
            Rectangle {
                border-radius: (22px * S.k);
                background: @linear-gradient(180deg, #111a33 0%, #0a1024 100%);
                border-width: 1px;
                border-color: Theme.line;
                TouchArea {}
                VerticalLayout {
                    padding-left: (48px * S.k);
                    padding-right: (48px * S.k);
                    padding-top: (40px * S.k);
                    padding-bottom: (40px * S.k);
                    spacing: (10px * S.k);
                    Text { text: @tr("Keyboard controls in games"); font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                    Text { text: root.launch-controller; font-size: (17px * S.k); color: root.launch-keyboard ? Theme.text3 : Theme.ok; }
                    Rectangle { height: (6px * S.k); }
                    // PS5 and PS4 games use different emulators, with different keys.
                    HorizontalLayout {
                        alignment: start;
                        spacing: (8px * S.k);
                        for tab[i] in [@tr("PS5 games · KytyPS5"), @tr("PS4 games · shadPS4")]: Rectangle {
                            property <bool> on: (i == 1) == root.controls-ps4;
                            width: tl.preferred-width + (28px * S.k);
                            height: (36px * S.k);
                            border-radius: (18px * S.k);
                            background: on ? #ffffff : #ffffff14;
                            tl := Text { text: tab; font-size: (16px * S.k); font-weight: 600; color: on ? #0a0d18 : Theme.text2; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.controls, i); } }
                        }
                        Text { text: "  " + @tr("◂ ▸ to switch"); font-size: (15px * S.k); color: Theme.text3; vertical-alignment: center; }
                    }
                    Rectangle { height: (6px * S.k); }
                    if root.controls-ps4: HorizontalLayout {
                        spacing: (56px * S.k);
                        for column in [
                            [{ what: @tr("✕  Cross"), keys: @tr("N  (or keypad 2)") }, { what: @tr("○  Circle"), keys: @tr("B  (or keypad 6)") }, { what: @tr("□  Square"), keys: @tr("V  (or keypad 4)") },
                             { what: @tr("△  Triangle"), keys: @tr("C  (or keypad 8)") }, { what: @tr("D-pad"), keys: @tr("Arrow keys") }, { what: @tr("Options"), keys: "Enter" }],
                            [{ what: @tr("Left stick"), keys: "W  A  S  D" }, { what: @tr("Right stick"), keys: "I  J  K  L" }, { what: "L1  /  R1", keys: "Q  /  U" },
                             { what: "L2  /  R2", keys: "E  /  O" }, { what: "L3  /  R3", keys: "X  /  M" }, { what: @tr("Touchpad"), keys: @tr("Space") }],
                        ]: VerticalLayout {
                            spacing: (12px * S.k);
                            for row in column: HorizontalLayout {
                                height: (30px * S.k);
                                spacing: (16px * S.k);
                                Text { text: row.what; width: (150px * S.k); font-size: (19px * S.k); color: Theme.text2; vertical-alignment: center; }
                                KeyCap { text: row.keys; }
                            }
                        }
                    }
                    if !root.controls-ps4: HorizontalLayout {
                        spacing: (56px * S.k);
                        for column in [
                            [{ what: @tr("✕  Cross"), keys: "J" }, { what: @tr("○  Circle"), keys: "L" }, { what: @tr("□  Square"), keys: "K" }, { what: @tr("△  Triangle"), keys: "I" },
                             { what: @tr("D-pad"), keys: @tr("Arrow keys") }, { what: @tr("Options"), keys: "Enter" }],
                            [{ what: @tr("Left stick"), keys: "W  A  S  D" }, { what: @tr("Right stick"), keys: "T  F  G  H" }, { what: "L1  /  R1", keys: "Q  /  E" },
                             { what: "L2  /  R2", keys: "Z  /  C" }, { what: "L3  /  R3", keys: @tr("Left Shift  /  Left Ctrl") }, { what: @tr("Touchpad"), keys: "Backspace  /  Tab" }],
                        ]: VerticalLayout {
                            spacing: (12px * S.k);
                            for row in column: HorizontalLayout {
                                height: (30px * S.k);
                                spacing: (16px * S.k);
                                Text { text: row.what; width: (150px * S.k); font-size: (19px * S.k); color: Theme.text2; vertical-alignment: center; }
                                KeyCap { text: row.keys; }
                            }
                        }
                    }
                    Rectangle { height: (10px * S.k); }
                    Text { text: root.controls-ps4 ? @tr("shadPS4 keeps its key layout in its own settings file; these are its defaults.") : @tr("F7 turns the mouse into the right stick (press it again to release the mouse)."); font-size: (16px * S.k); color: Theme.text3; }
                    Text {
                        text: @tr("Games play best with a controller: DualSense, DualShock 4, Xbox and most others work\nover USB or Bluetooth with no setup. Connect it before starting a game.");
                        font-size: (16px * S.k);
                        color: Theme.text3;
                    }
                    Rectangle { height: (6px * S.k); }
                    HorizontalLayout {
                        alignment: start;
                        BackButton { pad: root.pad-hints; clicked => { root.click(Zone.controls, -1); } }
                    }
                }
            }
                }
            }
        }
    }
}
